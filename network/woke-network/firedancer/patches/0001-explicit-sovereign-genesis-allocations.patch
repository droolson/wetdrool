       ulong hashes_per_tick;
       ulong target_tick_duration_micros;
       ulong ticks_per_slot;
diff --git a/src/app/shared/fd_config_parse.c b/src/app/shared/fd_config_parse.c
index a92623d..295bde9 100644
--- a/src/app/shared/fd_config_parse.c
+++ b/src/app/shared/fd_config_parse.c
@@ -297,6 +297,9 @@ fd_config_extract_pod( uchar *       pod,
 
   CFG_POP      ( bool,   development.gossip.allow_private_address         );
 
+  CFG_POP      ( ulong,  development.genesis.creation_time_unix_seconds   );
+  CFG_POP      ( ulong,  development.genesis.faucet_balance_lamports      );
+  CFG_POP      ( ulong,  development.genesis.identity_balance_lamports    );
   CFG_POP      ( ulong,  development.genesis.hashes_per_tick              );
   CFG_POP      ( ulong,  development.genesis.target_tick_duration_micros  );
   CFG_POP      ( ulong,  development.genesis.ticks_per_slot               );
diff --git a/src/app/shared_dev/commands/configure/genesis.c b/src/app/shared_dev/commands/configure/genesis.c
index ced3104..fb1509f 100644
--- a/src/app/shared_dev/commands/configure/genesis.c
+++ b/src/app/shared_dev/commands/configure/genesis.c
@@ -143,8 +143,11 @@ create_genesis( config_t const * config,
   memcpy( options->vote_pubkey.key, vote_pubkey_, 32 );
   fd_keyload_unload( vote_pubkey_, 1 );
 
-  options->creation_time      = (ulong)fd_log_wallclock() / (ulong)1e9;
-  options->faucet_balance     = 500000000000000000UL;
+  options->creation_time      = config->development.genesis.creation_time_unix_seconds
+                                  ? config->development.genesis.creation_time_unix_seconds
+                                  : (ulong)fd_log_wallclock() / (ulong)1e9;
+  options->faucet_balance     = config->development.genesis.faucet_balance_lamports;
+  options->identity_balance   = config->development.genesis.identity_balance_lamports;
   options->vote_account_stake = config->development.genesis.vote_account_stake_lamports;
 
   /* Set up PoH config */
diff --git a/src/flamenco/genesis/fd_genesis_create.c b/src/flamenco/genesis/fd_genesis_create.c
index 343d13e..0054e80 100644
--- a/src/flamenco/genesis/fd_genesis_create.c
+++ b/src/flamenco/genesis/fd_genesis_create.c
@@ -281,7 +281,7 @@ genesis_create( void *                       buf,
   fd_genesis_account_pair_t const identity_account = {
     .key = options->identity_pubkey,
     .account = {
-      .lamports   = 500000000000UL /* 500 SOL */,
+      .lamports   = options->identity_balance,
       .owner      = fd_solana_system_program_id
     }
   };
diff --git a/src/flamenco/genesis/fd_genesis_create.h b/src/flamenco/genesis/fd_genesis_create.h
index f7189ea..b49deb9 100644
--- a/src/flamenco/genesis/fd_genesis_create.h
+++ b/src/flamenco/genesis/fd_genesis_create.h
@@ -19,6 +19,7 @@ struct fd_genesis_options {
 
   ulong creation_time;      /* unix time, i.e. seconds since the unix epoch */
   ulong faucet_balance;     /* in lamports */
+  ulong identity_balance;   /* in lamports */
   ulong vote_account_stake; /* in lamports */
 
   ulong hashes_per_tick; /* 0 means unset */
diff --git a/src/flamenco/genesis/test_genesis_create.c b/src/flamenco/genesis/test_genesis_create.c
index 916aec5..ea52565 100644
--- a/src/flamenco/genesis/test_genesis_create.c
+++ b/src/flamenco/genesis/test_genesis_create.c
@@ -29,6 +29,8 @@ main( int     argc,
     .stake_pubkey                = { .ul = { 0, 0, 0, 3 } },
     .vote_pubkey                 = { .ul = { 0, 0, 0, 4 } },
     .creation_time               = 123UL,
+    .faucet_balance              = 1000000000UL,
+    .identity_balance            = 2000000000UL,
     .ticks_per_slot              = 64UL,
     .target_tick_duration_micros = 6250UL
   }};
@@ -76,6 +78,25 @@ main( int     argc,
 
   FD_TEST( genesis->creation_time == options->creation_time );
 
+  /* Verify explicit bootstrap allocations */
+
+  int found_faucet = 0;
+  int found_identity = 0;
+  for( ulong i=0UL; i<genesis->account_cnt; i++ ) {
+    fd_genesis_account_t account[1];
+    fd_genesis_account( genesis, result_mem, account, i );
+    if( fd_pubkey_eq( &account->pubkey, &options->faucet_pubkey ) ) {
+      FD_TEST( account->lamports == options->faucet_balance );
+      found_faucet = 1;
+    }
+    if( fd_pubkey_eq( &account->pubkey, &options->identity_pubkey ) ) {
+      FD_TEST( account->lamports == options->identity_balance );
+      found_identity = 1;
+    }
+  }
+  FD_TEST( found_faucet );
+  FD_TEST( found_identity );
+
   /* Verify epoch schedule defaults from fd_genesis_create */
 
   FD_TEST( genesis->epoch_schedule.slots_per_epoch == 8192UL );
diff --git a/src/app/shared/commands/version.c b/src/app/shared/commands/version.c
index a867432b6..5d2d453d9 100644
--- a/src/app/shared/commands/version.c
+++ b/src/app/shared/commands/version.c
@@ -6,7 +6,8 @@
 void
 version_cmd_fn( args_t *   args   FD_PARAM_UNUSED,
                 config_t * config FD_PARAM_UNUSED ) {
-  FD_LOG_STDOUT(( "%s (%s)\n", fd_version_cstr, fd_commit_ref_cstr ));
+  FD_LOG_STDOUT(( "Woke Network Firedancer downstream-v1 %s (%s)\n",
+                  fd_version_cstr, fd_commit_ref_cstr ));
 }
 
