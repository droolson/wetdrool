From: Woke Network Maintainers <security@woke.social>
Subject: [PATCH] Make sovereign genesis inputs explicit and reproducible

The upstream development genesis builder uses the wall clock, a fixed faucet
allocation, a fixed validator identity allocation, and requires funding
well-known benchmark keys. A sovereign network must make those consensus and
supply inputs explicit. Preserve upstream defaults while allowing a downstream
configuration to pin the timestamp and allocations and to fund zero benchmark
keys. Brand the executable version output with an explicit downstream marker so
operators can reject unrelated or pristine-upstream binaries.

diff --git a/src/app/firedancer/config/default.toml b/src/app/firedancer/config/default.toml
index c8670af..38c87a3 100644
--- a/src/app/firedancer/config/default.toml
+++ b/src/app/firedancer/config/default.toml
@@ -1816,6 +1816,16 @@ telemetry = true
         allow_private_address = false
 
     [development.genesis]
+        # Unix timestamp embedded in a newly-created genesis.  Zero preserves
+        # upstream behavior and uses the current wall clock.  A sovereign
+        # network ceremony should pin this to make genesis reproducible.
+        creation_time_unix_seconds = 0
+
+        # Explicit bootstrap allocations.  These defaults preserve upstream
+        # development behavior; downstream networks should override them.
+        faucet_balance_lamports = 500000000000000000
+        identity_balance_lamports = 500000000000
+
         # During normal operation, the genesi tile performs a validation
         # check on the genesis hash which ensures it belongs to one of
         # the three primary clusters (testnet, mainnet, devnet).  During
@@ -1864,10 +1874,11 @@ telemetry = true
         # The count of accounts to pre-fund in the genesis block with
         # SOL.  Useful for benchmarking and development.  The specific
         # accounts that will be funded are those with private-keys of
-        # 0, 1, 2, .... N.
+        # 0, 1, 2, .... N.  Set to zero to avoid well-known funded keys.
         fund_initial_accounts = 1024
 
-        # The amount of SOL to pre-fund each account with.
+        # The amount of SOL to pre-fund each account with.  This may be zero
+        # only when fund_initial_accounts is zero.
         fund_initial_amount_lamports = 50000000000000
 
         # The number of lamports to stake on the voting account of the
diff --git a/src/app/shared/fd_config.c b/src/app/shared/fd_config.c
index 5e35a2c..b172a6c 100644
--- a/src/app/shared/fd_config.c
+++ b/src/app/shared/fd_config.c
@@ -581,10 +581,15 @@ fd_config_validate( fd_config_t const * config ) {
 
   CFG_HAS_NON_EMPTY( development.core_dump );
 
+  CFG_HAS_NON_ZERO( development.genesis.faucet_balance_lamports );
+  CFG_HAS_NON_ZERO( development.genesis.identity_balance_lamports );
   CFG_HAS_NON_ZERO( development.genesis.target_tick_duration_micros );
   CFG_HAS_NON_ZERO( development.genesis.ticks_per_slot );
-  CFG_HAS_NON_ZERO( development.genesis.fund_initial_accounts );
-  CFG_HAS_NON_ZERO( development.genesis.fund_initial_amount_lamports );
+  if( FD_UNLIKELY( config->development.genesis.fund_initial_accounts &&
+                   !config->development.genesis.fund_initial_amount_lamports ) ) {
+    FD_LOG_ERR(( "`development.genesis.fund_initial_amount_lamports` must be non-zero when "
+                 "`development.genesis.fund_initial_accounts` is non-zero" ));
+  }
 
   CFG_HAS_NON_ZERO ( development.bench.benchg_tile_count );
   CFG_HAS_NON_ZERO ( development.bench.benchs_tile_count );
diff --git a/src/app/shared/fd_config.h b/src/app/shared/fd_config.h
index 8b9086f..ec7c58b 100644
--- a/src/app/shared/fd_config.h
+++ b/src/app/shared/fd_config.h
@@ -329,6 +329,9 @@ struct fd_config {
     } gossip;
 
     struct {
+      ulong creation_time_unix_seconds;
+      ulong faucet_balance_lamports;
