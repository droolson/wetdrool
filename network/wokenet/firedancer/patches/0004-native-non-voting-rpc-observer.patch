+  config->firedancer.layout.enable_block_production = 0;
+
+  config->tiles.rpc.enabled = 0;
+  FD_TEST( fd_config_wokenet_live_policy_check( config, 0, 0 )==FD_CONFIG_WOKENET_LIVE_ERR_VOTE_ACCOUNT_REQUIRED );
+  config->tiles.rpc.enabled = 1;
+
+  config->firedancer.paths.authorized_voter_paths_cnt = 1UL;
