+struct reader_ctx {
+  fd_sigstatuscache_t const * cache;
+  fd_sigstatuscache_bank_id_t view;
+  uchar                       signature[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fd_sigstatuscache_result_t  expected;
+  atomic_int                  started;
+  atomic_int                  seen;
+  atomic_int                  bad;
+};
+typedef struct reader_ctx reader_ctx_t;
+
+static void *
+reader_main( void * _ctx ) {
+  reader_ctx_t * ctx = (reader_ctx_t *)_ctx;
+  atomic_store_explicit( &ctx->started, 1, memory_order_release );
+  for( ulong i=0UL; i<2000000UL; i++ ) {
+    fd_sigstatuscache_query_result_t out;
+    fd_memset( &out, 0xA5, sizeof(out) );
+    fd_sigstatuscache_query_t q = fd_sigstatuscache_query( ctx->cache, ctx->view, ctx->signature, &out );
+    if( q==FD_SIGSTATUSCACHE_QUERY_NOT_FOUND || q==FD_SIGSTATUSCACHE_QUERY_AGAIN ) continue;
+    if( q==FD_SIGSTATUSCACHE_QUERY_FOUND &&
+        out.slot==88UL &&
+        fd_sigstatuscache_bank_id_eq( out.bank, ctx->view ) &&
+        result_eq( &out.result, &ctx->expected ) ) {
+      atomic_store_explicit( &ctx->seen, 1, memory_order_release );
+      return NULL;
+    }
+    atomic_store_explicit( &ctx->bad, 1, memory_order_release );
+    return NULL;
+  }
+  atomic_store_explicit( &ctx->bad, 1, memory_order_release );
+  return NULL;
+}
+
+static void
+test_read_only_atomic_publication( void ) {
+  FD_LOG_NOTICE(( "sigstatuscache: read-only mapping and atomic publication" ));
+
+  ulong footprint = fd_sigstatuscache_footprint( 4UL, 4UL, 8UL );
+  FILE * file = tmpfile();
+  FD_TEST( file );
+  int fd = fileno( file );
+  FD_TEST( fd>=0 );
+  FD_TEST( !ftruncate( fd, (off_t)footprint ) );
+
+  void * rw = mmap( NULL, footprint, PROT_READ|PROT_WRITE, MAP_SHARED, fd, 0 );
+  FD_TEST( rw!=MAP_FAILED );
+  void * ro = mmap( NULL, footprint, PROT_READ, MAP_SHARED, fd, 0 );
+  FD_TEST( ro!=MAP_FAILED );
+  FD_TEST( fd_sigstatuscache_new( rw, 4UL, 4UL, 8UL, 77UL )==rw );
+
+  fd_sigstatuscache_t * writer = fd_sigstatuscache_join( rw );
+  fd_sigstatuscache_t const * reader = fd_sigstatuscache_join( ro );
+  FD_TEST( writer );
+  FD_TEST( reader );
+
+  fd_sigstatuscache_bank_id_t bank = bank_id( 4UL, 99UL );
+  FD_TEST( fd_sigstatuscache_bank_attach( writer, bank, fd_sigstatuscache_bank_id_null(), 88UL )==FD_SIGSTATUSCACHE_OK );
+
+  uchar blockhash[ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ];
+  uchar signature[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fill_bytes( blockhash, sizeof(blockhash), 61U );
+  fill_bytes( signature, sizeof(signature), 62U );
+  fd_sigstatuscache_result_t expected = result( INT_MIN, -2, INT_MAX, UINT_MAX, UINT_MAX );
+  query_status( reader, bank, signature, FD_SIGSTATUSCACHE_QUERY_NOT_FOUND );
+
+  reader_ctx_t ctx = {
+    .cache    = reader,
+    .view     = bank,
+    .expected = expected
+  };
+  fd_memcpy( ctx.signature, signature, sizeof(signature) );
+  atomic_init( &ctx.started, 0 );
+  atomic_init( &ctx.seen,    0 );
+  atomic_init( &ctx.bad,     0 );
+
+  pthread_t thread;
+  FD_TEST( !pthread_create( &thread, NULL, reader_main, &ctx ) );
+  for( ulong i=0UL; !atomic_load_explicit( &ctx.started, memory_order_acquire ) && i<1000000UL; i++ )
+    FD_SPIN_PAUSE();
+  FD_TEST( atomic_load_explicit( &ctx.started, memory_order_acquire ) );
+
+  ulong seq = fd_sigstatuscache_publish_seq( writer );
+  FD_TEST( fd_sigstatuscache_insert( writer, bank, blockhash, signature, &expected )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_publish_seq( writer )==seq+1UL );
+  FD_TEST( !pthread_join( thread, NULL ) );
+  FD_TEST( atomic_load_explicit( &ctx.seen, memory_order_acquire ) );
+  FD_TEST( !atomic_load_explicit( &ctx.bad, memory_order_acquire ) );
+  query_found( reader, bank, signature, 88UL, bank, &expected );
+
+  FD_TEST( fd_sigstatuscache_delete( rw )==rw );
+  FD_TEST( !munmap( ro, footprint ) );
+  FD_TEST( !munmap( rw, footprint ) );
+  FD_TEST( !fclose( file ) );
+}
+
+static void
+test_bad_arguments_and_root_dead( void ) {
+  FD_LOG_NOTICE(( "sigstatuscache: bad arguments, stale views, and rooted DEAD rejection" ));
+
+  test_cache_t test = test_cache_new( 2UL, 2UL, 2UL, 55UL );
+  fd_sigstatuscache_bank_id_t root = bank_id( 1UL, 1UL );
+  uchar blockhash[ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ] = {0};
+  uchar signature[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ] = {0};
+  fd_sigstatuscache_result_t r = result( 0, 0, 0, UINT_MAX, 0U );
+  fd_sigstatuscache_query_result_t out;
+
+  FD_TEST( fd_sigstatuscache_bank_attach( test.cache, root, fd_sigstatuscache_bank_id_null(), 1UL )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_insert( NULL, root, blockhash, signature, &r )==FD_SIGSTATUSCACHE_ERR_INVAL );
+  FD_TEST( fd_sigstatuscache_insert( test.cache, fd_sigstatuscache_bank_id_null(), blockhash, signature, &r )==FD_SIGSTATUSCACHE_ERR_INVAL );
+  FD_TEST( fd_sigstatuscache_query( test.cache, bank_id( ULONG_MAX, 1UL ), signature, &out )==FD_SIGSTATUSCACHE_QUERY_BAD_ARGUMENT );
+  FD_TEST( fd_sigstatuscache_query( test.cache, root, NULL, &out )==FD_SIGSTATUSCACHE_QUERY_BAD_ARGUMENT );
+  FD_TEST( fd_sigstatuscache_query( test.cache, root, signature, NULL )==FD_SIGSTATUSCACHE_QUERY_BAD_ARGUMENT );
+  query_status( test.cache, bank_id( 99UL, 99UL ), signature, FD_SIGSTATUSCACHE_QUERY_STALE_VIEW );
+
+  FD_TEST( fd_sigstatuscache_publish_root( test.cache, root )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_bank_dead( test.cache, root )==FD_SIGSTATUSCACHE_ERR_BAD_STATE );
+  FD_TEST( !fd_sigstatuscache_is_complete( test.cache ) );
+  query_status( test.cache, root, signature, FD_SIGSTATUSCACHE_QUERY_INCOMPLETE );
+
+  test_cache_delete( &test );
+}
+
+int
+main( int     argc,
+      char ** argv ) {
+  fd_boot( &argc, &argv );
+
+  test_layout_and_lifecycle();
+  test_forks_reuse_dead_and_prune();
+  test_compact_keys_and_results();
+  test_root_retention();
+  test_capacity_and_incomplete();
+  test_read_only_atomic_publication();
+  test_bad_arguments_and_root_dead();
+
+  FD_LOG_NOTICE(( "pass" ));
+  fd_halt();
+  return 0;
+}
