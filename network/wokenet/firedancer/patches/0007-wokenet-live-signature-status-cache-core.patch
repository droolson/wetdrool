+static void
+test_root_retention( void ) {
+  FD_LOG_NOTICE(( "sigstatuscache: 300-root retention" ));
+
+  test_cache_t test = test_cache_new( 302UL, 2UL, 4UL, 9UL );
+  fd_sigstatuscache_t * cache = test.cache;
+  uchar blockhash[ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ];
+  uchar sig_old[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  uchar sig_keep[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fill_bytes( blockhash, sizeof(blockhash), 42U );
+  fill_bytes( sig_old,   sizeof(sig_old),   43U );
+  fill_bytes( sig_keep,  sizeof(sig_keep),  44U );
+  fd_sigstatuscache_result_t r_old  = result( 1, 2, 3, 4U, 5U );
+  fd_sigstatuscache_result_t r_keep = result( 6, 7, 8, UINT_MAX, UINT_MAX );
+
+  fd_sigstatuscache_bank_id_t current = bank_id( 0UL, 10UL );
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, current, fd_sigstatuscache_bank_id_null(), 1UL )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_insert( cache, current, blockhash, sig_old, &r_old )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_publish_root( cache, current )==FD_SIGSTATUSCACHE_OK );
+
+  fd_sigstatuscache_bank_id_t keep = bank_id( 1UL, 10UL );
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, keep, current, 2UL )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_insert( cache, keep, blockhash, sig_keep, &r_keep )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_publish_root( cache, keep )==FD_SIGSTATUSCACHE_OK );
+  current = keep;
+
+  for( ulong i=2UL; i<=300UL; i++ ) {
+    fd_sigstatuscache_bank_id_t next = bank_id( i, 10UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( cache, next, current, i+1UL )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_publish_root( cache, next )==FD_SIGSTATUSCACHE_OK );
+    current = next;
+  }
+
+  FD_TEST( fd_sigstatuscache_root_cnt( cache )==FD_SIGSTATUSCACHE_ROOT_MAX );
+  FD_TEST( fd_sigstatuscache_bank_cnt( cache )==FD_SIGSTATUSCACHE_ROOT_MAX );
+  query_status( cache, current, sig_old, FD_SIGSTATUSCACHE_QUERY_NOT_FOUND );
+  query_found( cache, current, sig_keep, 2UL, keep, &r_keep );
+  query_status( cache, bank_id( 0UL, 10UL ), sig_old, FD_SIGSTATUSCACHE_QUERY_STALE_VIEW );
+  FD_TEST( fd_sigstatuscache_is_complete( cache ) );
+
+  test_cache_delete( &test );
+}
