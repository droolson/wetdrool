+static void
+test_compact_keys_and_results( void ) {
+  FD_LOG_NOTICE(( "sigstatuscache: offsets, result roundtrips, and fail-closed collisions" ));
+
+  ulong const seed = 0x123456789UL;
+  test_cache_t test = test_cache_new( 2UL, 4UL, 16UL, seed );
+  fd_sigstatuscache_t * cache = test.cache;
+  fd_sigstatuscache_bank_id_t bank = bank_id( 1UL, 44UL );
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, bank, fd_sigstatuscache_bank_id_null(), 500UL )==FD_SIGSTATUSCACHE_OK );
+
+  uchar bh0 [ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ];
+  uchar bh11[ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ];
+  blockhash_for_offset( seed, 0UL,  bh0  );
+  blockhash_for_offset( seed, 11UL, bh11 );
+
+  uchar sig0 [ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  uchar sig11[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fill_bytes( sig0,  sizeof(sig0),  31U );
+  fill_bytes( sig11, sizeof(sig11), 97U );
+
+  fd_sigstatuscache_result_t custom0 = result( -8, -22, 3, UINT_MAX, 0U );
+  fd_sigstatuscache_result_t custom_max = result( INT_MIN, INT_MAX, -1, UINT_MAX, UINT_MAX );
+  fd_sigstatuscache_result_t other = result( 7, 8, 9, 10U, 11U );
+
+  FD_TEST( fd_sigstatuscache_insert( cache, bank, bh0, sig0, &custom0 )==FD_SIGSTATUSCACHE_OK );
+  ulong offset = ULONG_MAX;
+  FD_TEST( fd_sigstatuscache_group_key_offset( cache, bh0, &offset )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( offset==0UL );
+  query_found( cache, bank, sig0, 500UL, bank, &custom0 );
+  FD_TEST( fd_sigstatuscache_insert( cache, bank, bh0, sig0, &custom0 )==FD_SIGSTATUSCACHE_DUPLICATE );
+
+  uchar sig0_collision[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fd_memcpy( sig0_collision, sig0, sizeof(sig0_collision) );
+  sig0_collision[ 63 ] ^= (uchar)1; /* outside offset-0 [0,19] slice */
+  FD_TEST( memcmp( sig0_collision, sig0, sizeof(sig0_collision) ) );
+  FD_TEST( fd_sigstatuscache_insert( cache, bank, bh0, sig0_collision, &other )==FD_SIGSTATUSCACHE_ERR_CONFLICT );
+  query_status( cache, bank, sig0,           FD_SIGSTATUSCACHE_QUERY_AMBIGUOUS );
+  query_status( cache, bank, sig0_collision, FD_SIGSTATUSCACHE_QUERY_AMBIGUOUS );
+  FD_TEST( fd_sigstatuscache_is_complete( cache ) ); /* key-local ambiguity */
+
+  FD_TEST( fd_sigstatuscache_insert( cache, bank, bh11, sig11, &custom_max )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_group_key_offset( cache, bh11, &offset )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( offset==11UL );
+  query_found( cache, bank, sig11, 500UL, bank, &custom_max );
+
+  uchar sig11_collision[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fd_memcpy( sig11_collision, sig11, sizeof(sig11_collision) );
+  sig11_collision[ 0 ] ^= (uchar)1; /* outside offset-11 [11,30] slice */
+  FD_TEST( fd_sigstatuscache_insert( cache, bank, bh11, sig11_collision, &other )==FD_SIGSTATUSCACHE_ERR_CONFLICT );
+  query_status( cache, bank, sig11,           FD_SIGSTATUSCACHE_QUERY_AMBIGUOUS );
+  query_status( cache, bank, sig11_collision, FD_SIGSTATUSCACHE_QUERY_AMBIGUOUS );
+  FD_TEST( fd_sigstatuscache_is_complete( cache ) );
+
+  /* Two separately retained compact keys that both match one query are
+     also ambiguous, irrespective of insertion order or result. */
+  uchar sig_cross[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fill_bytes( sig_cross, sizeof(sig_cross), 173U );
+  FD_TEST( fd_sigstatuscache_insert( cache, bank, bh0,  sig_cross, &custom0   )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_insert( cache, bank, bh11, sig_cross, &custom_max )==FD_SIGSTATUSCACHE_OK );
+  query_status( cache, bank, sig_cross, FD_SIGSTATUSCACHE_QUERY_AMBIGUOUS );
+
+  uchar missing_bh[ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ];
+  fill_bytes( missing_bh, sizeof(missing_bh), 211U );
+  FD_TEST( fd_sigstatuscache_group_key_offset( cache, missing_bh, &offset )==FD_SIGSTATUSCACHE_ERR_NOT_FOUND );
+
+  test_cache_delete( &test );
+}
