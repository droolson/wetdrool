+static void
+test_forks_reuse_dead_and_prune( void ) {
+  FD_LOG_NOTICE(( "sigstatuscache: exact fork views, reuse, DEAD, and prune" ));
+
+  ulong const seed = 0xC0FFEEUL;
+  test_cache_t test = test_cache_new( 16UL, 8UL, 32UL, seed );
+  fd_sigstatuscache_t * cache = test.cache;
+
+  fd_sigstatuscache_bank_id_t root  = bank_id( 7UL, 1UL );
+  fd_sigstatuscache_bank_id_t a     = bank_id( 8UL, 1UL );
+  fd_sigstatuscache_bank_id_t b     = bank_id( 9UL, 1UL );
+  fd_sigstatuscache_bank_id_t sib   = bank_id( 10UL, 1UL );
+  fd_sigstatuscache_bank_id_t reuse = bank_id( 7UL, 2UL );
+
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, root, fd_sigstatuscache_bank_id_null(), 100UL )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, a,    root, 101UL )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, b,    a,    102UL )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, sib,  root, 101UL )==FD_SIGSTATUSCACHE_OK ); /* same-slot equivocation */
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, sib,  root, 101UL )==FD_SIGSTATUSCACHE_DUPLICATE );
+
+  uchar blockhash[ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ];
+  uchar sig_root[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  uchar sig_branch[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  uchar sig_b[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  uchar sig_reuse[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fill_bytes( blockhash,  sizeof(blockhash),  1U );
+  fill_bytes( sig_root,   sizeof(sig_root),   2U );
+  fill_bytes( sig_branch, sizeof(sig_branch), 3U );
+  fill_bytes( sig_b,      sizeof(sig_b),      4U );
+  fill_bytes( sig_reuse,  sizeof(sig_reuse),  5U );
+
+  fd_sigstatuscache_result_t r_root = result( 0, 0, 0, UINT_MAX, 0U );
+  fd_sigstatuscache_result_t r_a    = result( -1, -2, 3, 4U, 5U );
+  fd_sigstatuscache_result_t r_sib  = result( -6, -7, 2, 8U, 9U );
+  fd_sigstatuscache_result_t r_b    = result( -10, -11, 1, 12U, 13U );
+  fd_sigstatuscache_result_t r_reuse= result( -14, -15, 3, 16U, 17U );
+
+  FD_TEST( fd_sigstatuscache_insert( cache, root, blockhash, sig_root,   &r_root )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_insert( cache, a,    blockhash, sig_branch, &r_a )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_insert( cache, sib,  blockhash, sig_branch, &r_sib )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_insert( cache, b,    blockhash, sig_b,      &r_b )==FD_SIGSTATUSCACHE_OK );
+
+  query_found( cache, a,   sig_root,   100UL, root, &r_root );
+  query_found( cache, a,   sig_branch, 101UL, a,    &r_a );
+  query_found( cache, b,   sig_branch, 101UL, a,    &r_a );
+  query_found( cache, sib, sig_branch, 101UL, sib,  &r_sib );
+  query_status( cache, root, sig_branch, FD_SIGSTATUSCACHE_QUERY_NOT_FOUND );
+
+  FD_TEST( fd_sigstatuscache_publish_root( cache, root )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_root_cnt( cache )==1UL );
+
+  /* Same bank_idx, different bank_seq coexists with the retained root. */
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, reuse, root, 102UL )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_insert( cache, reuse, blockhash, sig_reuse, &r_reuse )==FD_SIGSTATUSCACHE_OK );
+  query_found( cache, reuse, sig_root,  100UL, root,  &r_root );
+  query_found( cache, reuse, sig_reuse, 102UL, reuse, &r_reuse );
+
+  FD_TEST( fd_sigstatuscache_bank_dead( cache, a )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_bank_dead( cache, a )==FD_SIGSTATUSCACHE_DUPLICATE );
+  query_status( cache, a, sig_branch, FD_SIGSTATUSCACHE_QUERY_STALE_VIEW );
+  query_status( cache, b, sig_b,      FD_SIGSTATUSCACHE_QUERY_STALE_VIEW );
+  query_found( cache, sib, sig_branch, 101UL, sib, &r_sib );
+  FD_TEST( fd_sigstatuscache_bank_attach( cache, a, root, 101UL )==FD_SIGSTATUSCACHE_ERR_STALE_BANK );
+  FD_TEST( fd_sigstatuscache_is_complete( cache ) );
+
+  /* Rooting the sibling prunes both DEAD tombstones and the other live
+     sibling, while preserving the exact canonical result. */
+  FD_TEST( fd_sigstatuscache_publish_root( cache, sib )==FD_SIGSTATUSCACHE_OK );
+  FD_TEST( fd_sigstatuscache_root_cnt( cache )==2UL );
+  FD_TEST( fd_sigstatuscache_bank_cnt( cache )==2UL );
+  query_found( cache, sib, sig_branch, 101UL, sib, &r_sib );
+  query_status( cache, reuse, sig_reuse, FD_SIGSTATUSCACHE_QUERY_STALE_VIEW );
+  FD_TEST( fd_sigstatuscache_publish_root( cache, sib )==FD_SIGSTATUSCACHE_DUPLICATE );
+  FD_TEST( fd_sigstatuscache_is_complete( cache ) );
+
+  test_cache_delete( &test );
+}
