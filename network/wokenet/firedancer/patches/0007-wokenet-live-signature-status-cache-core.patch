+static void
+test_capacity_and_incomplete( void ) {
+  FD_LOG_NOTICE(( "sigstatuscache: capacity and sticky incomplete" ));
+
+  uchar bh1[ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ];
+  uchar bh2[ FD_SIGSTATUSCACHE_BLOCKHASH_SZ ];
+  uchar sig1[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  uchar sig2[ FD_SIGSTATUSCACHE_SIGNATURE_SZ ];
+  fill_bytes( bh1,  sizeof(bh1),  1U );
+  fill_bytes( bh2,  sizeof(bh2),  2U );
+  fill_bytes( sig1, sizeof(sig1), 3U );
+  fill_bytes( sig2, sizeof(sig2), 4U );
+  fd_sigstatuscache_result_t r = result( -1, -2, 3, UINT_MAX, 0U );
+
+  {
+    test_cache_t test = test_cache_new( 1UL, 2UL, 2UL, 1UL );
+    fd_sigstatuscache_bank_id_t root = bank_id( 1UL, 1UL );
+    fd_sigstatuscache_bank_id_t child= bank_id( 2UL, 1UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, root, fd_sigstatuscache_bank_id_null(), 1UL )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_insert( test.cache, root, bh1, sig1, &r )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_publish_seq( test.cache )==2UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, child, root, 2UL )==FD_SIGSTATUSCACHE_ERR_NO_BANK_SPACE );
+    FD_TEST( fd_sigstatuscache_publish_seq( test.cache )==3UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, child, root, 2UL )==FD_SIGSTATUSCACHE_ERR_NO_BANK_SPACE );
+    FD_TEST( fd_sigstatuscache_publish_seq( test.cache )==3UL );
+    FD_TEST( !fd_sigstatuscache_is_complete( test.cache ) );
+    query_status( test.cache, root, sig1, FD_SIGSTATUSCACHE_QUERY_INCOMPLETE );
+    query_status( test.cache, root, sig2, FD_SIGSTATUSCACHE_QUERY_INCOMPLETE );
+    test_cache_delete( &test );
+  }
+
+  {
+    test_cache_t test = test_cache_new( 1UL, 1UL, 3UL, 2UL );
+    fd_sigstatuscache_bank_id_t root = bank_id( 1UL, 1UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, root, fd_sigstatuscache_bank_id_null(), 1UL )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_insert( test.cache, root, bh1, sig1, &r )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_insert( test.cache, root, bh2, sig2, &r )==FD_SIGSTATUSCACHE_ERR_NO_GROUP_SPACE );
+    FD_TEST( fd_sigstatuscache_group_cnt( test.cache )==1UL );
+    FD_TEST( fd_sigstatuscache_entry_cnt( test.cache )==1UL );
+    FD_TEST( !fd_sigstatuscache_is_complete( test.cache ) );
+    query_status( test.cache, root, sig1, FD_SIGSTATUSCACHE_QUERY_INCOMPLETE );
+    test_cache_delete( &test );
+  }
+
+  {
+    test_cache_t test = test_cache_new( 1UL, 2UL, 1UL, 3UL );
+    fd_sigstatuscache_bank_id_t root = bank_id( 1UL, 1UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, root, fd_sigstatuscache_bank_id_null(), 1UL )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_insert( test.cache, root, bh1, sig1, &r )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_insert( test.cache, root, bh1, sig2, &r )==FD_SIGSTATUSCACHE_ERR_NO_ENTRY_SPACE );
+    FD_TEST( fd_sigstatuscache_group_cnt( test.cache )==1UL );
+    FD_TEST( fd_sigstatuscache_entry_cnt( test.cache )==1UL );
+    FD_TEST( !fd_sigstatuscache_is_complete( test.cache ) );
+    test_cache_delete( &test );
+  }
+
+  {
+    test_cache_t test = test_cache_new( 2UL, 1UL, 1UL, 4UL );
+    fd_sigstatuscache_bank_id_t root = bank_id( 1UL, 1UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, root, fd_sigstatuscache_bank_id_null(), 1UL )==FD_SIGSTATUSCACHE_OK );
+    ulong seq = fd_sigstatuscache_publish_seq( test.cache );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, root, fd_sigstatuscache_bank_id_null(), 2UL )==FD_SIGSTATUSCACHE_ERR_CONFLICT );
+    FD_TEST( fd_sigstatuscache_publish_seq( test.cache )==seq+1UL );
+    FD_TEST( !fd_sigstatuscache_is_complete( test.cache ) );
+    query_status( test.cache, root, sig1, FD_SIGSTATUSCACHE_QUERY_INCOMPLETE );
+    test_cache_delete( &test );
+  }
+
+  {
+    /* DEAD tombstones are bounded by bank_max and reject resurrection. */
+    test_cache_t test = test_cache_new( 2UL, 2UL, 2UL, 5UL );
+    fd_sigstatuscache_bank_id_t root = bank_id( 1UL, 1UL );
+    fd_sigstatuscache_bank_id_t dead = bank_id( 2UL, 1UL );
+    fd_sigstatuscache_bank_id_t next = bank_id( 3UL, 1UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, root, fd_sigstatuscache_bank_id_null(), 1UL )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, dead, root, 2UL )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_insert( test.cache, dead, bh1, sig1, &r )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_bank_dead( test.cache, dead )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_bank_cnt( test.cache )==2UL );
+    FD_TEST( !fd_sigstatuscache_entry_cnt( test.cache ) );
+    FD_TEST( !fd_sigstatuscache_group_cnt( test.cache ) );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, dead, root, 2UL )==FD_SIGSTATUSCACHE_ERR_STALE_BANK );
+    FD_TEST( fd_sigstatuscache_bank_dead( test.cache, dead )==FD_SIGSTATUSCACHE_DUPLICATE );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, next, root, 3UL )==FD_SIGSTATUSCACHE_ERR_NO_BANK_SPACE );
+    FD_TEST( !fd_sigstatuscache_is_complete( test.cache ) );
+    query_status( test.cache, root, sig1, FD_SIGSTATUSCACHE_QUERY_INCOMPLETE );
+    test_cache_delete( &test );
+  }
+
+  {
+    /* A late insert into a DEAD exact identity is rejected and makes the
+       cache globally non-authoritative. */
+    test_cache_t test = test_cache_new( 3UL, 2UL, 2UL, 6UL );
+    fd_sigstatuscache_bank_id_t root = bank_id( 1UL, 1UL );
+    fd_sigstatuscache_bank_id_t dead = bank_id( 2UL, 1UL );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, root, fd_sigstatuscache_bank_id_null(), 1UL )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_bank_attach( test.cache, dead, root, 2UL )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_bank_dead( test.cache, dead )==FD_SIGSTATUSCACHE_OK );
+    FD_TEST( fd_sigstatuscache_insert( test.cache, dead, bh1, sig1, &r )==FD_SIGSTATUSCACHE_ERR_BAD_STATE );
+    FD_TEST( !fd_sigstatuscache_is_complete( test.cache ) );
+    query_status( test.cache, root, sig1, FD_SIGSTATUSCACHE_QUERY_INCOMPLETE );
+    test_cache_delete( &test );
+  }
+}
