 }
 
+static inline int
+utf8_consume( fd_slot_delta_parser_t * parser,
+              uchar const *            data,
+              ulong                    data_sz ) {
+  for( ulong i=0UL; i<data_sz; i++ ) {
+    uchar c = data[ i ];
+
+    if( parser->utf8_remaining ) {
+      if( FD_UNLIKELY( c<parser->utf8_next_min || c>parser->utf8_next_max ) ) return 0;
+      parser->utf8_remaining--;
+      parser->utf8_next_min = 0x80U;
+      parser->utf8_next_max = 0xbfU;
+      continue;
+    }
+
+    if( c<=0x7fU ) continue;
+
+    if( c>=0xc2U && c<=0xdfU ) {
+      parser->utf8_remaining = 1U;
+      parser->utf8_next_min  = 0x80U;
+      parser->utf8_next_max  = 0xbfU;
+    } else if( c==0xe0U ) {
+      parser->utf8_remaining = 2U;
+      parser->utf8_next_min  = 0xa0U;
+      parser->utf8_next_max  = 0xbfU;
+    } else if( (c>=0xe1U && c<=0xecU) || (c>=0xeeU && c<=0xefU) ) {
+      parser->utf8_remaining = 2U;
+      parser->utf8_next_min  = 0x80U;
+      parser->utf8_next_max  = 0xbfU;
+    } else if( c==0xedU ) {
+      parser->utf8_remaining = 2U;
+      parser->utf8_next_min  = 0x80U;
+      parser->utf8_next_max  = 0x9fU;
+    } else if( c==0xf0U ) {
+      parser->utf8_remaining = 3U;
+      parser->utf8_next_min  = 0x90U;
+      parser->utf8_next_max  = 0xbfU;
+    } else if( c>=0xf1U && c<=0xf3U ) {
+      parser->utf8_remaining = 3U;
+      parser->utf8_next_min  = 0x80U;
+      parser->utf8_next_max  = 0xbfU;
+    } else if( c==0xf4U ) {
+      parser->utf8_remaining = 3U;
+      parser->utf8_next_min  = 0x80U;
+      parser->utf8_next_max  = 0x8fU;
+    } else {
+      return 0;
+    }
+  }
+  return 1;
+}
+
 int
 fd_slot_delta_parser_consume( fd_slot_delta_parser_t *                parser,
                               uchar const *                           buf,
@@ -369,23 +456,40 @@ fd_slot_delta_parser_consume( fd_slot_delta_parser_t *                parser,
                               fd_slot_delta_parser_advance_result_t * result ) {
   uchar const * data    = buf;
   ulong         data_sz = bufsz;
-  while( data_sz ) {
-    if( FD_UNLIKELY( parser->state==STATE_DONE ) ) break;
-
-    ulong consume = fd_ulong_min( data_sz, parser->dst_sz-parser->dst_cur );
-
-    if( FD_LIKELY( parser->dst && consume ) ) {
-      memcpy( parser->dst+parser->dst_cur, data, consume );
+  result->bytes_consumed = 0UL;
+  result->txn_result     = NULL;
+  result->entry          = NULL;
+
+  for(;;) {
+    if( FD_LIKELY( parser->group_avail ) ) {
+      FD_TEST( parser->entry_avail==0 );
+      parser->group_avail          = 0;
+      result->group.blockhash      = parser->entry->blockhash;
+      result->group.txnhash_offset = parser->txnhash_offset;
+      result->bytes_consumed       = (ulong)(data - buf);
+      return FD_SLOT_DELTA_PARSER_ADVANCE_GROUP;
     }
 
-    parser->dst_cur += consume;
-    data            += consume;
-    data_sz         -= consume;
+    if( FD_LIKELY( parser->entry_avail ) ) {
+      FD_TEST( parser->group_avail==0 );
+      parser->entry_avail    = 0;
+      result->entry          = parser->entry;
+      result->txn_result     = parser->txn_result;
+      result->bytes_consumed = (ulong)(data - buf);
+      return FD_SLOT_DELTA_PARSER_ADVANCE_ENTRY;
+    }
 
-#if SLOT_DELTA_PARSER_DEBUG
-    state_log( parser );
-#endif
+    if( FD_UNLIKELY( parser->state==STATE_DONE ) ) {
+      result->bytes_consumed = (ulong)(data - buf);
+      if( FD_UNLIKELY( data_sz ) ) {
+        FD_LOG_WARNING(( "excess data in buffer" ));
+        return FD_SLOT_DELTA_PARSER_ADVANCE_ERROR_EXCESS_DATA_IN_BUFFER;
+      }
+      return FD_SLOT_DELTA_PARSER_ADVANCE_DONE;
+    }
 
+    /* Process a completed state before asking for more input.  In
+       particular, this drains a zero-length BorshIoError String at EOF. */
     if( FD_LIKELY( parser->dst_cur==parser->dst_sz ) ) {
       int err = state_validate( parser );
       if( FD_UNLIKELY( err ) ) {
@@ -398,41 +502,51 @@ fd_slot_delta_parser_consume( fd_slot_delta_parser_t *                parser,
       parser->dst     = state_dst( parser );
       parser->dst_sz  = state_size( parser );
       parser->dst_cur = 0UL;
+      continue;
+    }
 
-      if( FD_LIKELY( parser->group_avail ) ) {
-        FD_TEST( parser->entry_avail==0 );
-        parser->group_avail          = 0;
-        result->entry                = NULL;
