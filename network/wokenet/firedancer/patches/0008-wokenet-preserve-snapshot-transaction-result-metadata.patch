From 3266e0d76f2fa015194ace6369580572d2c941ff Mon Sep 17 00:00:00 2001
From: WokeNet Engineering <wokenet@local.invalid>
Date: Wed, 29 Jul 2026 03:02:48 -0400
Subject: [PATCH] WokeNet: preserve snapshot transaction result metadata

---
 src/discof/restore/fd_snapin_tile.c           |   70 +-
 .../restore/utils/fd_slot_delta_parser.c      |  258 ++--
 .../restore/utils/fd_slot_delta_parser.h      |   71 ++
 .../restore/utils/fuzz_slot_delta_parser.c    |   71 +-
 .../restore/utils/test_slot_delta_parser.c    | 1115 ++++++++++-------
 5 files changed, 1035 insertions(+), 550 deletions(-)

diff --git a/src/discof/restore/fd_snapin_tile.c b/src/discof/restore/fd_snapin_tile.c
index e931c0d57..c48a2caa2 100644
--- a/src/discof/restore/fd_snapin_tile.c
+++ b/src/discof/restore/fd_snapin_tile.c
@@ -449,6 +449,41 @@ transition_malformed( fd_snapin_tile_t *  ctx,
   fd_stem_publish( stem, ctx->ct_out.idx, FD_SNAPSHOT_MSG_CTRL_ERROR, 0UL, 0UL, 0UL, 0UL, 0UL );
 }
 
+static int
+process_slot_delta_advance( fd_snapin_tile_t *                           ctx,
+                            fd_stem_context_t *                          stem,
+                            int                                          advance,
+                            fd_slot_delta_parser_advance_result_t const * result ) {
+  if( FD_LIKELY( advance==FD_SLOT_DELTA_PARSER_ADVANCE_GROUP ) ) {
+    if( FD_UNLIKELY( ctx->blockhash_offsets_len>=FD_SNAPIN_MAX_SLOT_DELTA_GROUPS ) ) {
+      FD_LOG_WARNING(( "blockhash offsets overflow, max is %lu", FD_SNAPIN_MAX_SLOT_DELTA_GROUPS ));
+      transition_malformed( ctx, stem );
+      return 0;
+    }
+
+    memcpy( ctx->blockhash_offsets[ ctx->blockhash_offsets_len ].blockhash, result->group.blockhash, 32UL );
+    ctx->blockhash_offsets[ ctx->blockhash_offsets_len ].txnhash_offset = result->group.txnhash_offset;
+    ctx->blockhash_offsets_len++;
+  } else if( FD_LIKELY( advance==FD_SLOT_DELTA_PARSER_ADVANCE_ENTRY ) ) {
+    if( FD_UNLIKELY( ctx->txncache_entries_len>=FD_SNAPIN_TXNCACHE_MAX_ENTRIES ) ) {
+      FD_LOG_WARNING(( "txncache entries overflow, max is %lu", FD_SNAPIN_TXNCACHE_MAX_ENTRIES ));
+      transition_malformed( ctx, stem );
+      return 0;
+    }
+
+    /* The duplicate-detection txncache deliberately stages only the
+       compact transaction identity.  The typed result is parser-owned
+       metadata for a future shared status cache and is not retained here. */
+    ctx->txncache_entries[ ctx->txncache_entries_len++ ] = *result->entry;
+  } else if( advance==FD_SLOT_DELTA_PARSER_ADVANCE_BORSH_IO_ERROR_DATA ) {
+    /* BorshIoError String bytes borrow the snapshot input.  The parser
+       validates the stream, but snapin has no status-result store yet, so
+       explicitly discard these chunks. */
+  }
+
+  return 1;
+}
+
 static int
 populate_txncache( fd_snapin_tile_t *                     ctx,
                    fd_snapshot_manifest_blockhash_t const blockhashes[ static FD_BLOCKHASHES_MAX ],
@@ -1008,23 +1043,8 @@ handle_data_frag( fd_snapin_tile_t *  ctx,
             FD_LOG_WARNING(( "error while parsing slot deltas in status cache" ));
             transition_malformed( ctx, stem );
             return 0;
-          } else if( FD_LIKELY( res==FD_SLOT_DELTA_PARSER_ADVANCE_GROUP ) ) {
-            if( FD_UNLIKELY( ctx->blockhash_offsets_len>=FD_SNAPIN_MAX_SLOT_DELTA_GROUPS ) ) {
-              FD_LOG_WARNING(( "blockhash offsets overflow, max is %lu", FD_SNAPIN_MAX_SLOT_DELTA_GROUPS ));
-              transition_malformed( ctx, stem );
-              return 0;
-            }
-
-            memcpy( ctx->blockhash_offsets[ ctx->blockhash_offsets_len ].blockhash, sd_result->group.blockhash, 32UL );
-            ctx->blockhash_offsets[ ctx->blockhash_offsets_len ].txnhash_offset = sd_result->group.txnhash_offset;
-            ctx->blockhash_offsets_len++;
-          } else if( FD_LIKELY( res==FD_SLOT_DELTA_PARSER_ADVANCE_ENTRY ) ) {
-            if( FD_UNLIKELY( ctx->txncache_entries_len>=FD_SNAPIN_TXNCACHE_MAX_ENTRIES ) ) {
-              FD_LOG_WARNING(( "txncache entries overflow, max is %lu", FD_SNAPIN_TXNCACHE_MAX_ENTRIES ));
-              transition_malformed( ctx, stem );
-              return 0;
-            }
-            ctx->txncache_entries[ ctx->txncache_entries_len++ ] = *sd_result->entry;
+          } else if( FD_UNLIKELY( !process_slot_delta_advance( ctx, stem, res, sd_result ) ) ) {
+            return 0;
           }
 
           bytes_remaining           -= sd_result->bytes_consumed;
@@ -1032,13 +1052,17 @@ handle_data_frag( fd_snapin_tile_t *  ctx,
         }
 
         if( FD_UNLIKELY( result->status_cache.done ) ) {
-          int fini_res = fd_slot_delta_parser_consume( ctx->slot_delta_parser, result->status_cache.data, 0UL, sd_result );
-          if( FD_UNLIKELY( fini_res<0 ) ) {
-            FD_LOG_WARNING(( "error while finalizing slot deltas in status cache" ));
-            transition_malformed( ctx, stem );
-            return 0;
+          for(;;) {
+            int fini_res = fd_slot_delta_parser_consume( ctx->slot_delta_parser, result->status_cache.data, 0UL, sd_result );
+            if( FD_UNLIKELY( fini_res<0 ) ) {
+              FD_LOG_WARNING(( "error while finalizing slot deltas in status cache" ));
+              transition_malformed( ctx, stem );
+              return 0;
+            }
+            if( FD_UNLIKELY( !process_slot_delta_advance( ctx, stem, fini_res, sd_result ) ) ) return 0;
+            if( FD_LIKELY( fini_res==FD_SLOT_DELTA_PARSER_ADVANCE_DONE ) ) break;
           }
-          ctx->flags.status_cache_done = fini_res==FD_SLOT_DELTA_PARSER_ADVANCE_DONE;
+          ctx->flags.status_cache_done = 1;
         }
         break;
       }
