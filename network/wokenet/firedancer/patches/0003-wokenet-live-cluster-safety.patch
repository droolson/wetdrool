 }
 
+int
+fd_config_wokenet_live_policy_check( fd_config_t const * config,
+                                     int                 is_local_cluster,
+                                     int                 dev ) {
+  char const * cluster_genesis_hash =
+    config->is_firedancer
+      ? config->consensus.expected_genesis_hash
+      : config->frankendancer.consensus.expected_genesis_hash;
+  ulong cluster = fd_genesis_cluster_identify( cluster_genesis_hash );
+
+  if( FD_LIKELY( !config->consensus.wokenet_live_cluster ) ) {
+    if( FD_UNLIKELY( !is_local_cluster && !dev && cluster==FD_CLUSTER_UNKNOWN ) )
+      return FD_CONFIG_WOKENET_LIVE_ERR_MODE_REQUIRED;
+    return FD_CONFIG_WOKENET_LIVE_DISABLED;
+  }
+
+  if( FD_UNLIKELY( !config->is_firedancer ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_NATIVE_FIREDANCER_REQUIRED;
+  if( FD_UNLIKELY( is_local_cluster || dev ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_PRODUCTION_MODE_REQUIRED;
+  if( FD_UNLIKELY( !config->development.no_agave ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_NO_AGAVE_REQUIRED;
+
+  char const * expected_genesis_hash = config->consensus.expected_genesis_hash;
+  if( FD_UNLIKELY( !expected_genesis_hash[ 0 ] ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_GENESIS_HASH_REQUIRED;
+
+  uchar decoded_genesis_hash[ 32 ];
+  if( FD_UNLIKELY( !fd_base58_decode_32( expected_genesis_hash, decoded_genesis_hash ) ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_GENESIS_HASH_INVALID;
+  char canonical_genesis_hash[ FD_BASE58_ENCODED_32_SZ ];
+  fd_base58_encode_32( decoded_genesis_hash, NULL, canonical_genesis_hash );
+  if( FD_UNLIKELY( strcmp( expected_genesis_hash, canonical_genesis_hash ) ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_GENESIS_HASH_INVALID;
+  uchar const zero_genesis_hash[ 32 ] = {0};
+  if( FD_UNLIKELY( fd_memeq( decoded_genesis_hash, zero_genesis_hash, sizeof(decoded_genesis_hash) ) ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_GENESIS_HASH_INVALID;
+  if( FD_UNLIKELY( fd_genesis_cluster_identify( expected_genesis_hash )!=FD_CLUSTER_UNKNOWN ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_SOVEREIGN_HASH_REQUIRED;
+  if( FD_UNLIKELY( !config->consensus.expected_shred_version ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_SHRED_VERSION_REQUIRED;
+  if( FD_UNLIKELY( !config->firedancer.development.genesis.validate_genesis_hash ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_GENESIS_VALIDATION_REQUIRED;
+
+  if( FD_UNLIKELY( !config->paths.identity_key[ 0 ] ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_IDENTITY_REQUIRED;
+  if( FD_UNLIKELY( !config->development.sandbox ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_SANDBOX_REQUIRED;
+  if( FD_UNLIKELY( config->development.no_clone ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_MULTIPROCESS_REQUIRED;
+  if( FD_UNLIKELY( config->development.bench.larger_max_cost_per_block ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_LARGER_BLOCK_COST_FORBIDDEN;
+  if( FD_UNLIKELY( config->development.bench.larger_shred_limits_per_block ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_LARGER_SHREDS_FORBIDDEN;
+  if( FD_UNLIKELY( config->development.bench.disable_blockstore_from_slot ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_BLOCKSTORE_BYPASS_FORBIDDEN;
+  if( FD_UNLIKELY( config->development.bench.disable_status_cache ) )
+    return FD_CONFIG_WOKENET_LIVE_ERR_STATUS_CACHE_REQUIRED;
+
+  return FD_CONFIG_WOKENET_LIVE_OK;
+}
+
+void
+fd_config_classify_cluster( fd_config_t * config,
+                            int           is_local_cluster,
+                            int           dev ) {
+  ulong cluster;
+  if( FD_UNLIKELY( !config->is_firedancer ) ) cluster = fd_genesis_cluster_identify( config->frankendancer.consensus.expected_genesis_hash );
+  else                                        cluster = fd_genesis_cluster_identify( config->consensus.expected_genesis_hash );
+
+  int wokenet_live_policy = fd_config_wokenet_live_policy_check( config, is_local_cluster, dev );
+  switch( wokenet_live_policy ) {
+    case FD_CONFIG_WOKENET_LIVE_DISABLED:
+      break;
+    case FD_CONFIG_WOKENET_LIVE_OK:
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_NATIVE_FIREDANCER_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires the fully native Firedancer binary" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_PRODUCTION_MODE_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] cannot be used by a local-cluster or development command" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_NO_AGAVE_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires [development.no_agave] to be true" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_GENESIS_HASH_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires an exact [consensus.expected_genesis_hash]" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_GENESIS_HASH_INVALID:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires [consensus.expected_genesis_hash] to decode to exactly 32 non-zero bytes of base58" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_SOVEREIGN_HASH_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] cannot reuse a built-in Solana or Pyth genesis hash" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_SHRED_VERSION_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires a non-zero [consensus.expected_shred_version]" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_GENESIS_VALIDATION_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires [development.genesis.validate_genesis_hash] to be true" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_IDENTITY_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires an explicit [paths.identity_key]" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_SANDBOX_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires [development.sandbox] to be true" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_MULTIPROCESS_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] requires [development.no_clone] to be false" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_LARGER_BLOCK_COST_FORBIDDEN:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] forbids [development.bench.larger_max_cost_per_block]" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_LARGER_SHREDS_FORBIDDEN:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] forbids [development.bench.larger_shred_limits_per_block]" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_BLOCKSTORE_BYPASS_FORBIDDEN:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] forbids [development.bench.disable_blockstore_from_slot]" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_STATUS_CACHE_REQUIRED:
+      FD_LOG_ERR(( "[consensus.wokenet_live_cluster] forbids [development.bench.disable_status_cache]" ));
+      break;
+    case FD_CONFIG_WOKENET_LIVE_ERR_MODE_REQUIRED:
+      FD_LOG_ERR(( "unknown non-local production clusters must explicitly enable [consensus.wokenet_live_cluster]" ));
+      break;
+    default:
+      FD_LOG_ERR(( "invalid [consensus.wokenet_live_cluster] policy result" ));
+      break;
+  }
+
+  if( FD_UNLIKELY( wokenet_live_policy==FD_CONFIG_WOKENET_LIVE_OK ) ) {
+    config->is_live_cluster = 1;
+    strcpy( config->cluster, "wokenet" );
+  } else {
+    config->is_live_cluster = cluster!=FD_CLUSTER_UNKNOWN;
+    strcpy( config->cluster, fd_genesis_cluster_name( cluster ) );
+  }
+}
