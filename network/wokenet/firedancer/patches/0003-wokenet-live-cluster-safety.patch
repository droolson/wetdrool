     expected_genesis_hash = ""
 
+    # Downstream-only safety mode for a sovereign WokeNet production cluster.
+    # Local development and recognized upstream clusters may leave this false.
+    # Any unknown non-local production cluster must enable it and provide an
+    # exact expected_genesis_hash plus every live-cluster safety protection.
+    wokenet_live_cluster = false
+
     # Indicates if the client should wait for a vote published from this
     # node to land in a rooted slot before publishing any leader slots.
     # This check should be enabled to prevent a backup / failover node
