+static void
+test_scan_owner_nocache( void ) {
+  int fd;
+  fd_accdb_t * accdb = test_setup( &fd, 1024UL, 64UL, 8192UL, 8192UL, 1UL<<30UL );
+
+  fd_accdb_fork_id_t root  = fd_accdb_attach_child( accdb, SENTINEL );
+  fd_accdb_fork_id_t f1    = fd_accdb_attach_child( accdb, root );
+  fd_accdb_fork_id_t child = fd_accdb_attach_child( accdb, f1 );
+
+  uchar pk_a[ 32UL ] = { 0xA1 };
+  uchar pk_b[ 32UL ] = { 0xB2 };
+  uchar pk_c[ 32UL ] = { 0xC3 };
+  uchar pk_d[ 32UL ] = { 0xD4 };
+  uchar data_a[] = { 1U, 2U, 3U };
+  uchar data_b[] = { 4U, 5U };
+  uchar data_c[] = { 6U };
+  uchar data_d[] = { 7U, 8U, 9U, 10U };
+
+  accdb_write( accdb, f1, pk_a, 11UL, data_a, sizeof(data_a), owner2 );
+  accdb_write( accdb, f1, pk_b, 22UL, data_b, sizeof(data_b), owner2 );
+  accdb_write( accdb, f1, pk_c, 33UL, data_c, sizeof(data_c), owner3 );
+
+  uchar * scan_buf = aligned_alloc( 64UL, FD_RUNTIME_ACC_SZ_MAX );
+  FD_TEST( scan_buf );
+
+  scan_owner_test_ctx_t ctx = {0};
+  ulong work;
+  ulong data_bytes;
+  FD_TEST( fd_accdb_scan_owner_nocache( accdb, f1, owner2, 10000UL, 100UL,
+                                        scan_buf, scan_owner_test_visit, &ctx,
+                                        &work, &data_bytes )==FD_ACCDB_SCAN_SUCCESS );
+  FD_TEST( work>0UL );
+  FD_TEST( data_bytes==sizeof(data_a)+sizeof(data_b) );
+  FD_TEST( ctx.cnt==2UL );
+  FD_TEST( ctx.seen[ 0xA1 ] && ctx.seen[ 0xB2 ] && !ctx.seen[ 0xC3 ] );
+  FD_TEST( ctx.first_data[ 0xA1 ]==1U && ctx.data_len[ 0xA1 ]==sizeof(data_a) && ctx.lamports[ 0xA1 ]==11UL );
+  FD_TEST( ctx.first_data[ 0xB2 ]==4U && ctx.data_len[ 0xB2 ]==sizeof(data_b) && ctx.lamports[ 0xB2 ]==22UL );
