+typedef struct {
+  ulong cnt;
+  uchar seen[ 256UL ];
+  uchar first_data[ 256UL ];
+  ulong data_len[ 256UL ];
+  ulong lamports[ 256UL ];
+  ulong abort_after;
+} scan_owner_test_ctx_t;
+
+static int
+scan_owner_test_visit( void *        _ctx,
+                       uchar const * pubkey,
+                       ulong         lamports,
+                       int           executable,
+                       uchar const * data,
+                       ulong         data_len ) {
+  scan_owner_test_ctx_t * ctx = _ctx;
+  uchar tag = pubkey[ 0 ];
+  FD_TEST( !ctx->seen[ tag ] );
+  FD_TEST( !executable );
+  ctx->seen[ tag ]       = 1U;
+  ctx->first_data[ tag ] = data_len ? data[ 0 ] : 0U;
+  ctx->data_len[ tag ]   = data_len;
+  ctx->lamports[ tag ]   = lamports;
+  ctx->cnt++;
+  return ctx->abort_after && ctx->cnt>=ctx->abort_after;
+}
