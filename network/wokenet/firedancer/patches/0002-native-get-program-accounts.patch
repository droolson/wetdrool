+/* Bounded generic decoder for memcmp filters.  Firedancer's public
+   base58 decoder is specialized for 32- and 64-byte values; RPC filters
+   accept arbitrary byte strings up to 128 bytes. */
+static inline int
+fd_rpc_base58_decode_128( char const * b58,
+                          uchar *      out,
+                          ulong *      out_sz ) {
+  ulong b58_sz = strlen( b58 );
+  if( FD_UNLIKELY( b58_sz>FD_RPC_BASE58_ENCODED_128_LEN ) ) return 0;
+
+  ulong zero_cnt = 0UL;
+  while( zero_cnt<b58_sz && b58[ zero_cnt ]=='1' ) zero_cnt++;
+
+  /* Little-endian base-256 accumulator. */
+  uchar bin[ 128UL ] = {0};
+  ulong bin_sz = 0UL;
+  for( ulong i=zero_cnt; i<b58_sz; i++ ) {
+    char const * digit = strchr( base58_chars, b58[ i ] );
+    if( FD_UNLIKELY( !digit ) ) return 0;
+
+    ulong carry = (ulong)(digit-base58_chars);
+    for( ulong j=0UL; j<bin_sz; j++ ) {
+      carry += 58UL*(ulong)bin[ j ];
+      bin[ j ] = (uchar)(carry & 255UL);
+      carry >>= 8;
+    }
+    while( carry ) {
+      if( FD_UNLIKELY( bin_sz>=sizeof(bin) ) ) return 0;
+      bin[ bin_sz++ ] = (uchar)(carry & 255UL);
+      carry >>= 8;
+    }
+  }
+
+  if( FD_UNLIKELY( zero_cnt+bin_sz>128UL ) ) return 0;
+  memset( out, 0, zero_cnt );
+  for( ulong i=0UL; i<bin_sz; i++ ) out[ zero_cnt+i ] = bin[ bin_sz-1UL-i ];
+  *out_sz = zero_cnt+bin_sz;
+  return 1;
+}
