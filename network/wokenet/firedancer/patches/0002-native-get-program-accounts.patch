+
+static int
+fd_rpc_parse_program_config( fd_rpc_tile_t *             ctx,
+                             cJSON const *               id,
+                             cJSON const *               config,
+                             fd_rpc_program_filter_t *   filters,
+                             ulong *                     filter_cnt,
+                             int *                       with_context,
+                             int *                       sort_results,
+                             fd_http_server_response_t * response ) {
+  *filter_cnt   = 0UL;
+  *with_context = 0;
+  *sort_results = 1;
+  if( FD_UNLIKELY( !config || cJSON_IsNull( config ) ) ) return 1;
+
+  cJSON const * with_context_json = cJSON_GetObjectItemCaseSensitive( config, "withContext" );
+  if( FD_UNLIKELY( with_context_json && !cJSON_IsNull( with_context_json ) && !cJSON_IsBool( with_context_json ) ) )
+    return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: `withContext` must be a boolean", response );
+  if( FD_LIKELY( cJSON_IsBool( with_context_json ) ) ) *with_context = cJSON_IsTrue( with_context_json );
+
+  cJSON const * sort_results_json = cJSON_GetObjectItemCaseSensitive( config, "sortResults" );
+  if( FD_UNLIKELY( sort_results_json && !cJSON_IsNull( sort_results_json ) && !cJSON_IsBool( sort_results_json ) ) )
+    return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: `sortResults` must be a boolean", response );
+  if( FD_LIKELY( cJSON_IsBool( sort_results_json ) ) ) *sort_results = cJSON_IsTrue( sort_results_json );
+
+  cJSON const * filters_json = cJSON_GetObjectItemCaseSensitive( config, "filters" );
+  if( FD_UNLIKELY( !filters_json || cJSON_IsNull( filters_json ) ) ) return 1;
+  if( FD_UNLIKELY( !cJSON_IsArray( filters_json ) ) )
+    return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: `filters` must be an array", response );
+
+  int cnt = cJSON_GetArraySize( filters_json );
+  if( FD_UNLIKELY( cnt<0 || (ulong)cnt>FD_RPC_PROGRAM_MAX_FILTERS ) )
+    return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: too many filters; max 4", response );
+
+  for( int i=0; i<cnt; i++ ) {
+    cJSON const * filter = cJSON_GetArrayItem( filters_json, i );
+    if( FD_UNLIKELY( !cJSON_IsObject( filter ) || !filter->child || filter->child->next ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: each filter must be a map with one key", response );
+
+    cJSON const * body = filter->child;
+    if( FD_UNLIKELY( !body->string ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: malformed filter", response );
+
+    fd_rpc_program_filter_t * out = &filters[ (ulong)i ];
+    memset( out, 0, sizeof(fd_rpc_program_filter_t) );
+
+    if( !strcmp( body->string, "dataSize" ) ) {
+      if( FD_UNLIKELY( !fd_rpc_cjson_is_integer( body ) || body->valuedouble<0.0 ) )
+        return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: `dataSize` must be a non-negative integer", response );
+      out->kind  = FD_RPC_PROGRAM_FILTER_DATA_SIZE;
+      out->value = body->valueulong;
+      continue;
+    }
+
+    if( !strcmp( body->string, "tokenAccountState" ) )
+      return fd_rpc_program_config_error( ctx, id, -32065, "Firedancer Error: tokenAccountState filter is unsupported", response );
+
+    if( strcmp( body->string, "memcmp" ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: unknown program account filter", response );
+
+    if( FD_UNLIKELY( !cJSON_IsObject( body ) ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: `memcmp` must be a map", response );
+
+    cJSON const * offset_json   = cJSON_GetObjectItemCaseSensitive( body, "offset" );
+    cJSON const * bytes_json    = cJSON_GetObjectItemCaseSensitive( body, "bytes" );
+    cJSON const * encoding_json = cJSON_GetObjectItemCaseSensitive( body, "encoding" );
+    for( cJSON const * field=body->child; field; field=field->next ) {
+      if( FD_UNLIKELY( strcmp( field->string, "offset" ) &&
+                       strcmp( field->string, "bytes" ) &&
+                       strcmp( field->string, "encoding" ) ) )
+        return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: unknown `memcmp` field", response );
+    }
+
+    if( FD_UNLIKELY( !fd_rpc_cjson_is_integer( offset_json ) || offset_json->valuedouble<0.0 ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: memcmp `offset` must be a non-negative integer", response );
+    if( FD_UNLIKELY( !bytes_json ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: memcmp `bytes` is required", response );
+    if( FD_UNLIKELY( encoding_json && !cJSON_IsNull( encoding_json ) && !cJSON_IsString( encoding_json ) ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: memcmp `encoding` must be a string", response );
+
+    char const * encoding = cJSON_IsString( encoding_json ) ? encoding_json->valuestring : NULL;
+    out->kind  = FD_RPC_PROGRAM_FILTER_MEMCMP;
+    out->value = offset_json->valueulong;
+
+    if( cJSON_IsArray( bytes_json ) ) {
+      if( FD_UNLIKELY( encoding && strcmp( encoding, "bytes" ) ) )
+        return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: byte-array memcmp requires `bytes` encoding", response );
+
+      int bytes_cnt = cJSON_GetArraySize( bytes_json );
+      if( FD_UNLIKELY( bytes_cnt<0 || bytes_cnt>128 ) )
+        return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: memcmp exceeds 128 decoded bytes", response );
+      for( int j=0; j<bytes_cnt; j++ ) {
+        cJSON const * byte = cJSON_GetArrayItem( bytes_json, j );
+        if( FD_UNLIKELY( !fd_rpc_cjson_is_integer( byte ) || byte->valuedouble<0.0 || byte->valuedouble>255.0 ) )
+          return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: memcmp byte array must contain integers from 0 through 255", response );
+        out->bytes[ (ulong)j ] = (uchar)byte->valueint;
+      }
+      out->bytes_len = (ulong)bytes_cnt;
+      continue;
+    }
+
+    if( FD_UNLIKELY( !cJSON_IsString( bytes_json ) ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: memcmp `bytes` must be a string or byte array", response );
+
+    char const * encoded = bytes_json->valuestring;
+    if( FD_UNLIKELY( encoding && !strcmp( encoding, "bytes" ) ) )
+      return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: string memcmp cannot use `bytes` encoding", response );
+
+    if( !encoding || !strcmp( encoding, "base58" ) || !strcmp( encoding, "binary" ) ) {
+      if( FD_UNLIKELY( !fd_rpc_base58_decode_128( encoded, out->bytes, &out->bytes_len ) ) )
+        return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: invalid or oversized base58 memcmp bytes", response );
+      continue;
+    }
+
+    if( !strcmp( encoding, "base64" ) ) {
+      ulong encoded_sz = strlen( encoded );
+      if( FD_UNLIKELY( encoded_sz>FD_BASE64_ENC_SZ( 128UL ) ) )
+        return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: memcmp exceeds 128 decoded bytes", response );
+      uchar decoded[ FD_BASE64_DEC_SZ( FD_BASE64_ENC_SZ( 128UL ) ) ];
+      long decoded_sz = fd_base64_decode( decoded, encoded, encoded_sz );
+      if( FD_UNLIKELY( decoded_sz<0L || decoded_sz>128L ) )
+        return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: invalid or oversized base64 memcmp bytes", response );
+      memcpy( out->bytes, decoded, (ulong)decoded_sz );
+      out->bytes_len = (ulong)decoded_sz;
+      continue;
+    }
+
+    return fd_rpc_program_config_error( ctx, id, -32602, "Invalid params: memcmp encoding must be base58, base64, binary, or bytes", response );
+  }
+
+  *filter_cnt = (ulong)cnt;
+  return 1;
+}
+
+static int
+fd_rpc_program_scan_visit( void *        _ctx,
+                           uchar const * pubkey,
+                           ulong         lamports FD_PARAM_UNUSED,
+                           int           executable FD_PARAM_UNUSED,
+                           uchar const * data,
+                           ulong         data_len ) {
+  fd_rpc_program_scan_ctx_t * ctx = _ctx;
+  for( ulong i=0UL; i<ctx->filter_cnt; i++ ) {
+    fd_rpc_program_filter_t const * filter = &ctx->filters[ i ];
+    if( filter->kind==FD_RPC_PROGRAM_FILTER_DATA_SIZE ) {
+      if( FD_UNLIKELY( data_len!=filter->value ) ) return 0;
+      continue;
+    }
+
+    FD_TEST( filter->kind==FD_RPC_PROGRAM_FILTER_MEMCMP );
+    if( FD_UNLIKELY( filter->value>data_len ||
+                     filter->bytes_len>data_len-filter->value ||
+                     memcmp( data+filter->value, filter->bytes, filter->bytes_len ) ) ) return 0;
+  }
+
+  if( FD_UNLIKELY( ctx->result_cnt>=FD_RPC_PROGRAM_MAX_RESULTS ) ) {
+    ctx->limit_kind = FD_RPC_PROGRAM_LIMIT_RESULTS;
+    return 1;
+  }
+  if( FD_UNLIKELY( data_len>FD_RPC_PROGRAM_MATCHED_MAX_DATA_BYTES-ctx->matched_data_bytes ) ) {
+    ctx->limit_kind = FD_RPC_PROGRAM_LIMIT_DATA;
+    return 1;
+  }
+
+  memcpy( ctx->tile->program_accounts[ ctx->result_cnt++ ].uc, pubkey, 32UL );
+  ctx->matched_data_bytes += data_len;
+  return 0;
+}
+
+static void
+fd_rpc_sort_program_accounts( fd_pubkey_t * accounts,
+                              ulong         account_cnt ) {
+  for( ulong i=1UL; i<account_cnt; i++ ) {
+    fd_pubkey_t key = accounts[ i ];
+    ulong j = i;
+    while( j && memcmp( accounts[ j-1UL ].uc, key.uc, 32UL )>0 ) {
+      accounts[ j ] = accounts[ j-1UL ];
+      j--;
+    }
+    accounts[ j ] = key;
+  }
+}
+
+static fd_http_server_response_t
+getProgramAccounts( fd_rpc_tile_t * ctx,
+                    cJSON const *   id,
+                    cJSON const *   params ) {
+  fd_http_server_response_t response;
+  if( FD_UNLIKELY( !fd_rpc_validate_params( ctx, id, params, 1, 2, &response ) ) ) return response;
+
+  fd_pubkey_t program_id;
+  cJSON const * program_json = cJSON_GetArrayItem( params, 0 );
+  if( FD_UNLIKELY( !fd_rpc_validate_address( ctx, id, program_json, &program_id, &response ) ) ) return response;
+
+  ulong bank_idx = ULONG_MAX;
+  char const * encoding_cstr = NULL;
+  ulong slice_length = ULONG_MAX;
+  ulong slice_offset = 0UL;
+  cJSON const * config = cJSON_GetArrayItem( params, 1 );
+  if( FD_UNLIKELY( !fd_rpc_validate_config( ctx, id, config, "struct RpcProgramAccountsConfig",
+                                            1, 1, 1, 1,
+                                            &bank_idx, &encoding_cstr,
+                                            &slice_length, &slice_offset,
+                                            &response ) ) ) return response;
+
+  fd_rpc_program_filter_t filters[ FD_RPC_PROGRAM_MAX_FILTERS ];
+  ulong filter_cnt;
+  int with_context;
+  int sort_results;
+  if( FD_UNLIKELY( !fd_rpc_parse_program_config( ctx, id, config, filters, &filter_cnt,
+                                                 &with_context, &sort_results, &response ) ) ) return response;
+
+  fd_rpc_program_scan_ctx_t scan_ctx = {
+    .tile                 = ctx,
+    .filters              = filters,
+    .filter_cnt           = filter_cnt,
+    .result_cnt           = 0UL,
+    .matched_data_bytes   = 0UL,
+    .limit_kind           = FD_RPC_PROGRAM_LIMIT_NONE,
+  };
+
+  bank_info_t * info = &ctx->banks[ bank_idx ];
+  ulong scan_work;
+  ulong scan_data_bytes;
+  int scan_result = fd_accdb_scan_owner_nocache( ctx->accdb, info->accdb_fork_id, program_id.uc,
+                                                 FD_RPC_PROGRAM_SCAN_MAX_WORK,
+                                                 FD_RPC_PROGRAM_SCAN_MAX_DATA_BYTES,
+                                                 ctx->accdb_data_buf,
+                                                 fd_rpc_program_scan_visit, &scan_ctx,
+                                                 &scan_work, &scan_data_bytes );
+  if( FD_UNLIKELY( scan_result!=FD_ACCDB_SCAN_SUCCESS ) ) {
+    if( scan_result==FD_ACCDB_SCAN_ERR_WORK_LIMIT ) {
+      fd_rpc_program_config_error( ctx, id, -32065, "Firedancer Error: getProgramAccounts scan work limit exceeded", &response );
+      return response;
+    }
+    if( scan_result==FD_ACCDB_SCAN_ERR_DATA_LIMIT ) {
+      fd_rpc_program_config_error( ctx, id, -32065, "Firedancer Error: getProgramAccounts scan data limit exceeded", &response );
+      return response;
+    }
+    if( scan_result==FD_ACCDB_SCAN_ERR_CALLBACK && scan_ctx.limit_kind==FD_RPC_PROGRAM_LIMIT_RESULTS ) {
+      fd_rpc_program_config_error( ctx, id, -32065, "Firedancer Error: getProgramAccounts result limit exceeded; max 1024", &response );
+      return response;
+    }
+    if( scan_result==FD_ACCDB_SCAN_ERR_CALLBACK && scan_ctx.limit_kind==FD_RPC_PROGRAM_LIMIT_DATA ) {
+      fd_rpc_program_config_error( ctx, id, -32065, "Firedancer Error: getProgramAccounts pre-slice matched account data limit exceeded", &response );
+      return response;
+    }
+    fd_rpc_program_config_error( ctx, id, -32065, "Firedancer Error: getProgramAccounts scan aborted", &response );
+    return response;
+  }
+  (void)scan_work;
+  (void)scan_data_bytes;
+
+  if( FD_LIKELY( sort_results ) )
+    fd_rpc_sort_program_accounts( ctx->program_accounts, scan_ctx.result_cnt );
+
+  CSTR_JSON( id, id_cstr );
+  if( with_context ) {
+    fd_http_server_printf( ctx->http,
+        "{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"context\":{\"apiVersion\":\"%s\",\"slot\":%lu},\"value\":[",
+        id_cstr, FD_RPC_AGAVE_API_VERSION, info->slot );
+  } else {
+    fd_http_server_printf( ctx->http, "{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":[", id_cstr );
+  }
+
+  for( ulong i=0UL; i<scan_ctx.result_cnt; i++ ) {
+    if( i ) fd_http_server_printf( ctx->http, "," );
+
+    ulong acct_lamports;
+    int   acct_executable;
+    uchar acct_owner[ 32UL ];
+    ulong acct_data_len;
+    fd_accdb_read_one_nocache( ctx->accdb, info->accdb_fork_id, ctx->program_accounts[ i ].uc,
+                               &acct_lamports, &acct_executable, acct_owner,
+                               ctx->accdb_data_buf, &acct_data_len );
+    if( FD_UNLIKELY( !acct_lamports || memcmp( acct_owner, program_id.uc, 32UL ) ) ) {
+      fd_http_server_unstage( ctx->http );
+      return PRINTF_JSON( ctx, "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32065,\"message\":\"Firedancer Error: account changed during frozen-fork scan\"},\"id\":%s}\n", id_cstr );
+    }
+
+    FD_BASE58_ENCODE_32_BYTES( ctx->program_accounts[ i ].uc, pubkey_b58 );
+    fd_http_server_printf( ctx->http, "{\"pubkey\":\"%s\",\"account\":", pubkey_b58 );
+
+    fd_http_server_response_t err_response;
+    if( FD_UNLIKELY( !fd_rpc_encode_account_data( ctx, ctx->accdb_data_buf, acct_data_len,
+                                                  acct_owner, acct_lamports, acct_executable,
+                                                  encoding_cstr, slice_offset, slice_length,
+                                                  id_cstr, &err_response ) ) ) return err_response;
+    fd_http_server_printf( ctx->http, "}" );
+  }
+
+  fd_http_server_printf( ctx->http, with_context ? "]}}\n" : "]}\n" );
+  return STAGE_JSON( ctx );
+}
+
