+/* fd_accdb_scan_owner_nocache visits every live account owned by owner
+   that is visible at fork_id.  The caller must hold a reference to
+   fork_id and guarantee that the fork is frozen (no account commits to
+   fork_id or an ancestor visible from it) for the duration of the call.
+   Root advancement, compaction, and cache eviction may run
+   concurrently.
+
+   The scan is suitable for a read-only join.  It publishes the joiner's
+   epoch for the whole operation, walks only the lazily initialized
+   prefix of the account pool, selects the first visible version of each
+   pubkey, and uses the same cache ABA validation and epoch-protected
+   disk reads as fd_accdb_read_one_nocache.
+
+   visit is called once per matching account, in unspecified order.
+   data points to data_buf and is valid only for the duration of the
+   callback.  data_buf must have room for FD_RUNTIME_ACC_SZ_MAX bytes.
+   The callback must not call another accdb API.  A non-zero callback
+   return aborts the scan with FD_ACCDB_SCAN_ERR_CALLBACK.
+
+   max_work bounds the sum of pool entries and hash-chain nodes
+   inspected.  max_data_bytes bounds the aggregate data bytes copied or
+   read for owner-matched accounts.  A limit error may occur after prior
+   callbacks, so callers must not publish accumulated results unless
+   FD_ACCDB_SCAN_SUCCESS is returned.  opt_work and opt_data_bytes, when
+   non-NULL, receive the consumed totals on every return path. */
+
+#define FD_ACCDB_SCAN_SUCCESS         ( 0)
+#define FD_ACCDB_SCAN_ERR_WORK_LIMIT  (-1)
+#define FD_ACCDB_SCAN_ERR_DATA_LIMIT  (-2)
+#define FD_ACCDB_SCAN_ERR_CALLBACK    (-3)
+
+typedef int
+(*fd_accdb_scan_owner_fn_t)( void *        cb_arg,
+                             uchar const * pubkey,
+                             ulong         lamports,
+                             int           executable,
+                             uchar const * data,
+                             ulong         data_len );
+
+int
+fd_accdb_scan_owner_nocache( fd_accdb_t *              accdb,
+                             fd_accdb_fork_id_t        fork_id,
+                             uchar const *             owner,
+                             ulong                     max_work,
+                             ulong                     max_data_bytes,
+                             uchar *                   data_buf,
+                             fd_accdb_scan_owner_fn_t  visit,
+                             void *                    cb_arg,
+                             ulong *                   opt_work,
+                             ulong *                   opt_data_bytes );
+
 /* fd_accdb_lamports returns the lamports of the account at fork_id, or
    zero if the account does not exist. */
 
