+static void
+fd_accdb_scan_pread( fd_accdb_t * accdb,
+                     void *       dst,
+                     ulong        sz,
+                     ulong        off ) {
+  ulong got = 0UL;
+  while( FD_LIKELY( got<sz ) ) {
+    long result = pread( accdb->fd, (uchar *)dst+got, sz-got, (long)(off+got) );
+    if( FD_UNLIKELY( -1==result && (errno==EINTR || errno==EAGAIN || errno==EWOULDBLOCK) ) ) continue;
+    else if( FD_UNLIKELY( -1==result ) ) FD_LOG_ERR(( "pread() failed (%d-%s)", errno, fd_io_strerror( errno ) ));
+    else if( FD_UNLIKELY( !result ) ) FD_LOG_ERR(( "accounts database is corrupt, data expected at offset %lu with size %lu exceeded file extents", off+got, sz ));
+
+    fd_accdb_partition_read_bump( accdb, off+got, (ulong)result );
+    got += (ulong)result;
+    accdb->metrics->bytes_read += (ulong)result;
+    accdb->metrics->read_ops++;
+  }
+}
+
+/* fd_accdb_scan_read_owner_data compares the selected accmeta's owner
+   and copies its data only when the owner matches.  The caller already
+   holds the scan epoch.  Returns 1 on owner match, 0 on mismatch, and
+   FD_ACCDB_SCAN_ERR_DATA_LIMIT if copying the matching data would cross
+   max_data_bytes. */
+static int
+fd_accdb_scan_read_owner_data( fd_accdb_t *               accdb,
+                               fd_accdb_accmeta_t const *  accmeta,
+                               uchar const *               pubkey,
+                               uchar const *               owner,
+                               uint                        snap_es,
+                               uint                        snap_gen,
+                               uint                        snap_cidx,
+                               ulong                       max_data_bytes,
+                               ulong *                     data_bytes,
+                               uchar *                     data_buf ) {
+  ulong data_len = (ulong)FD_ACCDB_SIZE_DATA( snap_es );
+  uchar found_owner[ 32UL ];
+
+  if( FD_LIKELY( FD_ACCDB_SIZE_CACHE_VALID( snap_es ) && snap_cidx!=FD_ACCDB_ACC_CIDX_INVAL ) ) {
+    ulong cls = FD_ACCDB_ACC_CIDX_CLASS( snap_cidx );
+    ulong idx = FD_ACCDB_ACC_CIDX_IDX  ( snap_cidx );
+    fd_accdb_cache_line_t * line = cache_line( accdb, cls, idx );
+
+    for(;;) {
+      uint gen0 = FD_VOLATILE_CONST( line->key.generation );
+      uint rc0  = FD_VOLATILE_CONST( line->refcnt );
+      uint ai0  = FD_VOLATILE_CONST( line->acc_idx );
+      if( FD_UNLIKELY( rc0==FD_ACCDB_EVICT_SENTINEL ) ) goto miss;
+      if( FD_UNLIKELY( gen0!=snap_gen ) ) goto miss;
+      if( FD_UNLIKELY( memcmp( line->key.pubkey, pubkey, 32UL ) ) ) goto miss;
+      if( FD_UNLIKELY( ai0==UINT_MAX ) ) goto miss;
+
+      FD_COMPILER_MFENCE();
+      memcpy( found_owner, line->owner, 32UL );
+      int owner_match = !memcmp( found_owner, owner, 32UL );
+      int data_limit  = owner_match && data_len>max_data_bytes-*data_bytes;
+      if( FD_LIKELY( owner_match && !data_limit ) )
+        memcpy( data_buf, (uchar const *)(line+1UL), data_len );
+      FD_COMPILER_MFENCE();
+
+      uint gen1 = FD_VOLATILE_CONST( line->key.generation );
+      uint rc1  = FD_VOLATILE_CONST( line->refcnt );
+      uint ai1  = FD_VOLATILE_CONST( line->acc_idx );
+      if( FD_UNLIKELY( rc1==FD_ACCDB_EVICT_SENTINEL ) ) goto miss;
+      if( FD_UNLIKELY( gen1!=snap_gen ) ) goto miss;
+      if( FD_UNLIKELY( memcmp( line->key.pubkey, pubkey, 32UL ) ) ) goto miss;
+      if( FD_UNLIKELY( ai1==UINT_MAX ) ) goto miss;
+
+      if( FD_UNLIKELY( !owner_match ) ) return 0;
+      if( FD_UNLIKELY( data_limit ) ) return FD_ACCDB_SCAN_ERR_DATA_LIMIT;
+
+      *data_bytes += data_len;
+      accdb->metrics->bytes_copied += data_len;
+      return 1;
+    }
+  }
+
+miss:
+  accdb->metrics->accounts_not_found_per_class[ fd_accdb_cache_class( data_len ) ]++;
+
+  ulong off_packed = FD_VOLATILE_CONST( accmeta->offset_fork );
+  if( FD_UNLIKELY( (off_packed & FD_ACCDB_OFF_MASK)==FD_ACCDB_OFF_INVAL ) ) {
+    accdb->metrics->accounts_waited++;
+    while( FD_UNLIKELY( ((off_packed=FD_VOLATILE_CONST( accmeta->offset_fork )) & FD_ACCDB_OFF_MASK)==FD_ACCDB_OFF_INVAL ) ) FD_SPIN_PAUSE();
+  }
+  ulong off = off_packed & FD_ACCDB_OFF_MASK;
+
+  fd_accdb_scan_pread( accdb, found_owner, 32UL, off+offsetof( fd_accdb_disk_meta_t, owner ) );
+  if( FD_UNLIKELY( memcmp( found_owner, owner, 32UL ) ) ) return 0;
+  if( FD_UNLIKELY( data_len>max_data_bytes-*data_bytes ) ) return FD_ACCDB_SCAN_ERR_DATA_LIMIT;
+
+  fd_accdb_scan_pread( accdb, data_buf, data_len, off+sizeof(fd_accdb_disk_meta_t) );
+  *data_bytes += data_len;
+  return 1;
+}
+
+int
+fd_accdb_scan_owner_nocache( fd_accdb_t *             accdb,
+                             fd_accdb_fork_id_t       fork_id,
+                             uchar const *            owner,
+                             ulong                    max_work,
+                             ulong                    max_data_bytes,
+                             uchar *                  data_buf,
+                             fd_accdb_scan_owner_fn_t visit,
+                             void *                   cb_arg,
+                             ulong *                  opt_work,
+                             ulong *                  opt_data_bytes ) {
+  FD_TEST( accdb );
+  FD_TEST( owner );
+  FD_TEST( data_buf );
+  FD_TEST( visit );
+
+  ulong work       = 0UL;
+  ulong data_bytes = 0UL;
+  int   result     = FD_ACCDB_SCAN_SUCCESS;
+
+  FD_COMPILER_MFENCE();
+  FD_VOLATILE( *accdb->my_epoch_slot ) = FD_VOLATILE_CONST( accdb->shmem->epoch );
+  FD_HW_MFENCE();
+
+  uint root_generation = accdb->fork_pool[ accdb->shmem->root_fork_id.val ].shmem->generation;
+  fd_accdb_fork_t * fork = &accdb->fork_pool[ fork_id.val ];
+
+  /* ver_lazy points at the first never-allocated pool element.  Once
+     lazy allocation is exhausted it contains the pool null index, in
+     which case every element may have been initialized at least once. */
+  ulong ele_max  = acc_pool_ele_max( accdb->acc_pool_join );
+  ulong lazy_idx = acc_pool_private_vidx_idx( FD_VOLATILE_CONST( accdb->acc_pool_join->pool->ver_lazy ) );
+  ulong scan_cnt = fd_ulong_min( lazy_idx, ele_max );
+
+  for( ulong scan_idx=0UL; scan_idx<scan_cnt; scan_idx++ ) {
+    if( FD_UNLIKELY( work>=max_work ) ) {
+      result = FD_ACCDB_SCAN_ERR_WORK_LIMIT;
+      goto fini;
+    }
+    work++;
+
+    fd_accdb_accmeta_t const * scan_acc = &accdb->acc_pool[ scan_idx ];
+    uchar scan_pubkey[ 32UL ];
+    memcpy( scan_pubkey, scan_acc->key.pubkey, 32UL );
+    uint scan_gen = FD_VOLATILE_CONST( scan_acc->key.generation );
+
+    ulong hash = fd_accdb_hash( scan_pubkey, accdb->shmem->seed )&(accdb->shmem->chain_cnt-1UL);
+    uint acc_idx = FD_VOLATILE_CONST( accdb->acc_map[ hash ] );
+    int selected = 0;
+
+    while( acc_idx!=UINT_MAX ) {
+      if( FD_UNLIKELY( work>=max_work ) ) {
+        result = FD_ACCDB_SCAN_ERR_WORK_LIMIT;
+        goto fini;
+      }
+      work++;
+
+      fd_accdb_accmeta_t const * candidate = &accdb->acc_pool[ acc_idx ];
+      uint next_idx = FD_VOLATILE_CONST( candidate->map.next );
+      int visible = candidate->key.generation<=root_generation ||
+                    fd_accdb_acc_fork_id(candidate)==fork_id.val ||
+                    descends_set_test( fork->descends, fd_accdb_acc_fork_id(candidate) );
+
+      if( FD_LIKELY( visible && !memcmp( scan_pubkey, candidate->key.pubkey, 32UL ) ) ) {
+        selected = acc_idx==(uint)scan_idx;
+        break;
+      }
+      acc_idx = next_idx;
+    }
+
+    if( FD_UNLIKELY( !selected ) ) continue;
+
+    /* Free pool entries retain stale metadata.  Hash-chain membership
+       above distinguishes live entries; this revalidation also rejects
+       an entry that was being initialized while the scan passed it. */
+    if( FD_UNLIKELY( scan_gen!=FD_VOLATILE_CONST( scan_acc->key.generation ) ||
+                     memcmp( scan_pubkey, scan_acc->key.pubkey, 32UL ) ) ) continue;
+
+    uint  snap_es       = FD_VOLATILE_CONST( scan_acc->executable_size );
+    uint  snap_cidx     = FD_VOLATILE_CONST( scan_acc->cache_idx );
+    ulong snap_lamports = FD_VOLATILE_CONST( scan_acc->lamports );
+    if( FD_UNLIKELY( !snap_lamports ) ) continue;
+
+    ulong data_len = (ulong)FD_ACCDB_SIZE_DATA( snap_es );
+    accdb->metrics->accounts_acquired_per_class[ fd_accdb_cache_class( data_len ) ]++;
+
+    int owner_match = fd_accdb_scan_read_owner_data( accdb, scan_acc, scan_pubkey, owner,
+                                                     snap_es, scan_gen, snap_cidx,
+                                                     max_data_bytes, &data_bytes, data_buf );
+    if( FD_UNLIKELY( owner_match==FD_ACCDB_SCAN_ERR_DATA_LIMIT ) ) {
+      result = FD_ACCDB_SCAN_ERR_DATA_LIMIT;
+      goto fini;
+    }
+    if( FD_UNLIKELY( !owner_match ) ) continue;
+
+    if( FD_UNLIKELY( visit( cb_arg, scan_pubkey, snap_lamports,
+                            FD_ACCDB_SIZE_EXEC( snap_es ), data_buf, data_len ) ) ) {
+      result = FD_ACCDB_SCAN_ERR_CALLBACK;
+      goto fini;
+    }
+  }
+
+fini:
+  FD_COMPILER_MFENCE();
+  FD_VOLATILE( *accdb->my_epoch_slot ) = ULONG_MAX;
+  if( FD_LIKELY( opt_work ) )      *opt_work      = work;
+  if( FD_LIKELY( opt_data_bytes ) ) *opt_data_bytes = data_bytes;
+  return result;
+}
+
 int
 fd_accdb_exists( fd_accdb_t *       accdb,
                  fd_accdb_fork_id_t fork_id,
