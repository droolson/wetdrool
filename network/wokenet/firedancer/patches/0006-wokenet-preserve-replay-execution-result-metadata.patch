+static inline void
+txn_info_clear_exec_err( fd_sched_txn_info_t * txn_info ) {
+  txn_info->exec_err      = FD_EXECUTOR_INSTR_SUCCESS;
+  txn_info->exec_err_kind = FD_EXECUTOR_ERR_KIND_NONE;
+  txn_info->exec_err_idx  = UINT_MAX;
+  txn_info->custom_err    = 0U;
+}
+
+static inline int
+txn_info_exec_identity_matches( fd_sched_txn_info_t const *      txn_info,
+                                fd_execrp_task_done_msg_t const * msg,
+                                fd_bank_t const *                 bank ) {
+  return txn_info->slot==msg->txn_exec->slot &&
+         txn_info->bank_idx==msg->bank_idx &&
+         (txn_info->bank_seq==ULONG_MAX || txn_info->bank_seq==msg->txn_exec->bank_seq) &&
+         bank->idx==msg->bank_idx &&
+         bank->f.slot==msg->txn_exec->slot &&
+         bank->bank_seq==msg->txn_exec->bank_seq;
+}
+
+static inline void
+txn_info_validate_exec_identity( fd_sched_txn_info_t const *          txn_info,
+                                 fd_execrp_task_done_msg_t const *     msg,
+                                 fd_bank_t const *                     bank ) {
+  if( FD_UNLIKELY( !txn_info_exec_identity_matches( txn_info, msg, bank ) ) ) {
+    FD_LOG_CRIT(( "invariant violation: transaction execution completion identity mismatch "
+                  "(scheduled slot=%lu bank_idx=%lu bank_seq=%lu, completion slot=%lu bank_idx=%lu bank_seq=%lu, "
+                  "live slot=%lu bank_idx=%lu bank_seq=%lu)",
+                  txn_info->slot,
+                  txn_info->bank_idx,
+                  txn_info->bank_seq,
+                  msg->txn_exec->slot,
+                  msg->bank_idx,
+                  msg->txn_exec->bank_seq,
+                  bank->f.slot,
+                  bank->idx,
+                  bank->bank_seq ));
+  }
+}
+
+static inline int
+txn_info_sigverify_identity_matches( fd_sched_txn_info_t const *      txn_info,
+                                     fd_execrp_task_done_msg_t const * msg,
+                                     fd_bank_t const *                 bank ) {
+  return txn_info->slot==msg->txn_sigverify->slot &&
+         txn_info->bank_idx==msg->bank_idx &&
+         (txn_info->bank_seq==ULONG_MAX || txn_info->bank_seq==msg->txn_sigverify->bank_seq) &&
+         bank->idx==msg->bank_idx &&
+         bank->f.slot==msg->txn_sigverify->slot &&
+         bank->bank_seq==msg->txn_sigverify->bank_seq;
+}
+
+static inline void
+txn_info_validate_sigverify_identity( fd_sched_txn_info_t const *      txn_info,
+                                      fd_execrp_task_done_msg_t const * msg,
+                                      fd_bank_t const *                 bank ) {
+  if( FD_UNLIKELY( !txn_info_sigverify_identity_matches( txn_info, msg, bank ) ) ) {
+    FD_LOG_CRIT(( "invariant violation: transaction signature-verification completion identity mismatch "
+                  "(scheduled slot=%lu bank_idx=%lu bank_seq=%lu, completion slot=%lu bank_idx=%lu bank_seq=%lu, "
+                  "live slot=%lu bank_idx=%lu bank_seq=%lu)",
+                  txn_info->slot,
+                  txn_info->bank_idx,
+                  txn_info->bank_seq,
+                  msg->txn_sigverify->slot,
+                  msg->bank_idx,
+                  msg->txn_sigverify->bank_seq,
+                  bank->f.slot,
+                  bank->idx,
+                  bank->bank_seq ));
+  }
+}
+
+static inline void
+txn_info_apply_exec_result( fd_sched_txn_info_t *                    txn_info,
+                            fd_execrp_task_done_msg_t const *         msg ) {
+  txn_info->flags    |= FD_SCHED_TXN_EXEC_DONE;
+  txn_info->slot      = msg->txn_exec->slot;
+  txn_info->bank_idx  = msg->bank_idx;
+  txn_info->bank_seq  = msg->txn_exec->bank_seq;
+
+  /* A signature failure is authoritative regardless of which worker
+     completion arrived first.  The execution completion still supplies
+     the validated bank_seq, but cannot overwrite the canonical error. */
+  if( FD_UNLIKELY( txn_info->flags&FD_SCHED_TXN_SIGVERIFY_FAIL ) ) return;
+
+  txn_info->flags &= ~(FD_SCHED_TXN_IS_COMMITTABLE|FD_SCHED_TXN_IS_FEES_ONLY);
+  txn_info->flags |= fd_ulong_if( msg->txn_exec->is_committable, FD_SCHED_TXN_IS_COMMITTABLE, 0UL );
+  txn_info->flags |= fd_ulong_if( msg->txn_exec->is_fees_only,   FD_SCHED_TXN_IS_FEES_ONLY,   0UL );
+  txn_info->txn_err = msg->txn_exec->txn_err;
+
+  if( FD_LIKELY( txn_info->txn_err==FD_RUNTIME_TXN_ERR_INSTRUCTION_ERROR ) ) {
+    txn_info->exec_err      = msg->txn_exec->exec_err;
+    txn_info->exec_err_kind = msg->txn_exec->exec_err_kind;
+    txn_info->exec_err_idx  = msg->txn_exec->exec_err_idx;
+    txn_info->custom_err    = fd_uint_if( msg->txn_exec->exec_err==FD_EXECUTOR_INSTR_ERR_CUSTOM_ERR,
+                                         msg->txn_exec->custom_err,
+                                         0U );
+  } else {
+    txn_info_clear_exec_err( txn_info );
+  }
+}
+
+static inline void
+txn_info_apply_sigverify_result( fd_sched_txn_info_t * txn_info,
+                                 int                   failed ) {
+  txn_info->flags |= FD_SCHED_TXN_SIGVERIFY_DONE;
+  if( FD_LIKELY( !failed ) ) return;
+
+  txn_info->flags |= FD_SCHED_TXN_SIGVERIFY_FAIL;
+  txn_info->flags &= ~(FD_SCHED_TXN_IS_COMMITTABLE|FD_SCHED_TXN_IS_FEES_ONLY);
+  txn_info->txn_err = FD_RUNTIME_TXN_ERR_SIGNATURE_FAILURE;
+  txn_info_clear_exec_err( txn_info );
+}
+
+static inline void
+txn_executed_from_info( fd_replay_txn_executed_t *   txn_executed,
+                        fd_txn_p_t const *            txn,
+                        fd_sched_txn_info_t const *   txn_info ) {
+  FD_TEST( (txn_info->flags&FD_SCHED_TXN_REPLAY_DONE)==FD_SCHED_TXN_REPLAY_DONE );
+  FD_TEST( txn_info->bank_seq!=ULONG_MAX );
+
+  fd_memset( txn_executed, 0, sizeof(*txn_executed) );
+  *txn_executed->txn            = *txn;
+  txn_executed->slot            = txn_info->slot;
+  txn_executed->bank_idx        = txn_info->bank_idx;
+  txn_executed->bank_seq        = txn_info->bank_seq;
+  txn_executed->txn_err         = txn_info->txn_err;
+  txn_executed->exec_err        = txn_info->exec_err;
+  txn_executed->exec_err_kind   = txn_info->exec_err_kind;
+  txn_executed->exec_err_idx    = txn_info->exec_err_idx;
+  txn_executed->custom_err      = txn_info->custom_err;
+  txn_executed->is_committable  = !!(txn_info->flags&FD_SCHED_TXN_IS_COMMITTABLE);
+  txn_executed->is_fees_only    = !!(txn_info->flags&FD_SCHED_TXN_IS_FEES_ONLY);
+  txn_executed->tick_parsed         = txn_info->tick_parsed;
+  txn_executed->tick_sigverify_disp = txn_info->tick_sigverify_disp;
+  txn_executed->tick_sigverify_done = txn_info->tick_sigverify_done;
+  txn_executed->tick_exec_disp      = txn_info->tick_exec_disp;
+  txn_executed->tick_exec_done      = txn_info->tick_exec_done;
+}
+
