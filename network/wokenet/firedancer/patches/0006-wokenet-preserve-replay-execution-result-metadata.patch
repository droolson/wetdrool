+  fd_bank_t * bank = fd_svm_mini_bank( env->mini, env->bank_idx );
+  FD_TEST( bank );
+
+  fd_pubkey_t fee_payer = { .ul = { 0xa1a1UL } };
+  fd_pubkey_t data_acct = { .ul = { 0xb2b2UL } };
+  fd_txn_p_t txn[1];
+  test_build_empty_txn( txn, bank, fee_payer, data_acct, 0xc3c3UL, 0 );
+  txn->start_shred_idx = 11U;
+  txn->end_shred_idx   = 19U;
+
+  env->execrp->bank               = bank;
+  env->execrp->txn_idx            = 77UL;
+  env->execrp->slot               = bank->f.slot;
+  env->execrp->txn_in.txn         = txn;
+  env->execrp->txn_out.err.is_committable = 1;
+  env->execrp->txn_out.err.is_fees_only   = 0;
+  env->execrp->txn_out.err.txn_err        = FD_RUNTIME_TXN_ERR_INSTRUCTION_ERROR;
+  env->execrp->txn_out.err.exec_err       = FD_EXECUTOR_INSTR_ERR_CUSTOM_ERR;
+  env->execrp->txn_out.err.exec_err_kind  = FD_EXECUTOR_ERR_KIND_INSTR;
+  env->execrp->txn_out.err.exec_err_idx   = 7U;
+  env->execrp->txn_out.err.custom_err     = UINT_MAX;
+  env->execrp->txn_out.details.is_simple_vote = 0;
+
+  fd_stem_context_t stem[1];
+  publish_txn_finalized_msg( env->execrp, test_stem( env->execrp, stem ) );
+
+  fd_execrp_task_done_msg_t const * out_msg = test_assert_out_msg( env, 0UL, FD_EXECRP_TT_TXN_EXEC );
+  FD_TEST( out_msg->bank_idx==bank->idx );
+  FD_TEST( out_msg->txn_exec->txn_idx==77UL );
+  FD_TEST( out_msg->txn_exec->slot==bank->f.slot );
+  FD_TEST( out_msg->txn_exec->bank_seq==bank->bank_seq );
+  FD_TEST( out_msg->txn_exec->is_committable==1 );
+  FD_TEST( out_msg->txn_exec->is_fees_only==0 );
+  FD_TEST( out_msg->txn_exec->txn_err==FD_RUNTIME_TXN_ERR_INSTRUCTION_ERROR );
+  FD_TEST( out_msg->txn_exec->exec_err==FD_EXECUTOR_INSTR_ERR_CUSTOM_ERR );
+  FD_TEST( out_msg->txn_exec->exec_err_kind==FD_EXECUTOR_ERR_KIND_INSTR );
+  FD_TEST( out_msg->txn_exec->exec_err_idx==7U );
+  FD_TEST( out_msg->txn_exec->custom_err==UINT_MAX );
