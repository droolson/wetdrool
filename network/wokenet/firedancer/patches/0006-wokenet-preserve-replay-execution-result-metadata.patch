+static void
+test_txn_result_propagation( void ) {
+  ulong const slot     = 88UL;
+  ulong const bank_idx = 4UL;
+  ulong const bank_seq = 9001UL;
+
+  static fd_bank_t bank[1];
+  fd_memset( bank, 0, sizeof(*bank) );
+  bank->idx      = bank_idx;
+  bank->f.slot   = slot;
+  bank->bank_seq = bank_seq;
+
+  fd_execrp_task_done_msg_t exec_msg[1] = {{
+    .bank_idx = bank_idx,
+    .txn_exec = {{
+      .txn_idx        = 7UL,
+      .is_committable = 1,
+      .is_fees_only   = 0,
+      .txn_err        = FD_RUNTIME_TXN_ERR_INSTRUCTION_ERROR,
+      .exec_err       = FD_EXECUTOR_INSTR_ERR_CUSTOM_ERR,
+      .exec_err_kind  = FD_EXECUTOR_ERR_KIND_INSTR,
+      .exec_err_idx   = 5U,
+      .custom_err     = UINT_MAX,
+      .slot           = slot,
+      .bank_seq       = bank_seq,
+    }},
+  }};
+  fd_execrp_task_done_msg_t sig_msg[1] = {{
+    .bank_idx = bank_idx,
+    .txn_sigverify = {{
+      .txn_idx  = 7UL,
+      .slot     = slot,
+      .bank_seq = bank_seq,
+      .err      = 0,
+    }},
+  }};
+
+  /* Successful execution result reaches the replay event unchanged. */
+  fd_sched_txn_info_t info[1];
+  fd_sched_txn_info_reset( info, slot, bank_idx, 3UL, 101L );
+  FD_TEST( txn_info_exec_identity_matches( info, exec_msg, bank ) );
+  FD_TEST( txn_info_sigverify_identity_matches( info, sig_msg, bank ) );
+  txn_info_validate_exec_identity( info, exec_msg, bank );
+  txn_info_apply_exec_result( info, exec_msg );
+  txn_info_validate_sigverify_identity( info, sig_msg, bank );
+  txn_info_apply_sigverify_result( info, 0 );
+
+  FD_TEST( info->bank_seq==bank_seq );
+  FD_TEST( info->txn_err==FD_RUNTIME_TXN_ERR_INSTRUCTION_ERROR );
+  FD_TEST( info->exec_err==FD_EXECUTOR_INSTR_ERR_CUSTOM_ERR );
+  FD_TEST( info->exec_err_kind==FD_EXECUTOR_ERR_KIND_INSTR );
+  FD_TEST( info->exec_err_idx==5U );
+  FD_TEST( info->custom_err==UINT_MAX );
+
+  fd_txn_p_t txn[1];
+  fd_memset( txn, 0, sizeof(*txn) );
+  txn->payload[0] = 0x5aU;
+  fd_replay_txn_executed_t executed[1];
+  txn_executed_from_info( executed, txn, info );
+  FD_TEST( executed->txn->payload[0]==0x5aU );
+  FD_TEST( executed->slot==slot );
+  FD_TEST( executed->bank_idx==bank_idx );
+  FD_TEST( executed->bank_seq==bank_seq );
+  FD_TEST( executed->is_committable==1 );
+  FD_TEST( executed->is_fees_only==0 );
+  FD_TEST( executed->txn_err==FD_RUNTIME_TXN_ERR_INSTRUCTION_ERROR );
+  FD_TEST( executed->exec_err==FD_EXECUTOR_INSTR_ERR_CUSTOM_ERR );
+  FD_TEST( executed->exec_err_kind==FD_EXECUTOR_ERR_KIND_INSTR );
+  FD_TEST( executed->exec_err_idx==5U );
+  FD_TEST( executed->custom_err==UINT_MAX );
+
+  /* Every identity component participates in validation. */
+  fd_execrp_task_done_msg_t bad_exec_msg[1] = { *exec_msg };
+  bad_exec_msg->txn_exec->slot++;
+  FD_TEST( !txn_info_exec_identity_matches( info, bad_exec_msg, bank ) );
+  *bad_exec_msg = *exec_msg;
+  bad_exec_msg->bank_idx++;
+  FD_TEST( !txn_info_exec_identity_matches( info, bad_exec_msg, bank ) );
+  *bad_exec_msg = *exec_msg;
+  bad_exec_msg->txn_exec->bank_seq++;
+  FD_TEST( !txn_info_exec_identity_matches( info, bad_exec_msg, bank ) );
+
+  fd_execrp_task_done_msg_t bad_sig_msg[1] = { *sig_msg };
+  bad_sig_msg->txn_sigverify->slot++;
+  FD_TEST( !txn_info_sigverify_identity_matches( info, bad_sig_msg, bank ) );
+  *bad_sig_msg = *sig_msg;
+  bad_sig_msg->bank_idx++;
+  FD_TEST( !txn_info_sigverify_identity_matches( info, bad_sig_msg, bank ) );
+  *bad_sig_msg = *sig_msg;
+  bad_sig_msg->txn_sigverify->bank_seq++;
+  FD_TEST( !txn_info_sigverify_identity_matches( info, bad_sig_msg, bank ) );
+
+  /* Execution before failed signature verification: signature failure
+     replaces the full execution result. */
+  fd_sched_txn_info_reset( info, slot, bank_idx, 3UL, 102L );
+  txn_info_validate_exec_identity( info, exec_msg, bank );
+  txn_info_apply_exec_result( info, exec_msg );
+  sig_msg->txn_sigverify->err = 1;
+  txn_info_validate_sigverify_identity( info, sig_msg, bank );
+  txn_info_apply_sigverify_result( info, 1 );
+  assert_signature_failure_result( info, slot, bank_idx, bank_seq );
+
+  txn_executed_from_info( executed, txn, info );
+  FD_TEST( executed->txn_err==FD_RUNTIME_TXN_ERR_SIGNATURE_FAILURE );
+  FD_TEST( executed->exec_err==FD_EXECUTOR_INSTR_SUCCESS );
+  FD_TEST( executed->exec_err_kind==FD_EXECUTOR_ERR_KIND_NONE );
+  FD_TEST( executed->exec_err_idx==UINT_MAX );
+  FD_TEST( executed->custom_err==0U );
+  FD_TEST( !executed->is_committable );
+  FD_TEST( !executed->is_fees_only );
+
+  /* Failed signature verification before execution: the later worker
+     result supplies bank_seq but cannot overwrite the canonical
+     signature failure. */
+  fd_sched_txn_info_reset( info, slot, bank_idx, 3UL, 103L );
+  txn_info_validate_sigverify_identity( info, sig_msg, bank );
+  txn_info_apply_sigverify_result( info, 1 );
+  txn_info_validate_exec_identity( info, exec_msg, bank );
+  txn_info_apply_exec_result( info, exec_msg );
+  assert_signature_failure_result( info, slot, bank_idx, bank_seq );
+
+  /* Nested instruction fields are canonical sentinels for a
+     non-instruction transaction error even if a malformed producer
+     supplies nonzero values. */
+  fd_sched_txn_info_reset( info, slot, bank_idx, 3UL, 104L );
+  exec_msg->txn_exec->txn_err       = FD_RUNTIME_TXN_ERR_ACCOUNT_NOT_FOUND;
+  exec_msg->txn_exec->exec_err      = FD_EXECUTOR_INSTR_ERR_CUSTOM_ERR;
+  exec_msg->txn_exec->exec_err_kind = FD_EXECUTOR_ERR_KIND_INSTR;
+  exec_msg->txn_exec->exec_err_idx  = 99U;
+  exec_msg->txn_exec->custom_err    = 123U;
+  txn_info_validate_exec_identity( info, exec_msg, bank );
+  txn_info_apply_exec_result( info, exec_msg );
+  sig_msg->txn_sigverify->err = 0;
+  txn_info_apply_sigverify_result( info, 0 );
+  FD_TEST( info->txn_err==FD_RUNTIME_TXN_ERR_ACCOUNT_NOT_FOUND );
+  FD_TEST( info->exec_err==FD_EXECUTOR_INSTR_SUCCESS );
+  FD_TEST( info->exec_err_kind==FD_EXECUTOR_ERR_KIND_NONE );
+  FD_TEST( info->exec_err_idx==UINT_MAX );
+  FD_TEST( info->custom_err==0U );
+
+  FD_LOG_NOTICE(( "pass: test_txn_result_propagation" ));
+}
