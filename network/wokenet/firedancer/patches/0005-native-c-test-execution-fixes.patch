+/* Use a plain mmap-backed workspace so this unit test can run in
+   containerized x86-64 CI where NUMA policy syscalls may be unavailable.
+   The production shmem/NUMA path is exercised by its own tests. */
+
+static fd_wksp_t *
+test_wksp_new_mmap( ulong        footprint,
+                    char const * name ) {
+  FD_TEST( footprint && !(footprint%FD_SHMEM_NORMAL_PAGE_SZ) );
+  void * mem = mmap( NULL, footprint, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0 );
+  FD_TEST( mem!=MAP_FAILED );
+
+  ulong part_max = fd_wksp_part_max_est( footprint, 64UL<<10 );
+  ulong data_max = fd_wksp_data_max_est( footprint, part_max );
+  FD_TEST( part_max );
+  FD_TEST( data_max );
+
+  fd_wksp_t * wksp = fd_wksp_join( fd_wksp_new( mem, name, 1U, part_max, data_max ) );
+  FD_TEST( wksp );
+  FD_TEST( !fd_shmem_join_anonymous( name,
+                                     FD_SHMEM_JOIN_MODE_READ_WRITE,
+                                     wksp,
+                                     mem,
+                                     FD_SHMEM_NORMAL_PAGE_SZ,
+                                     footprint/FD_SHMEM_NORMAL_PAGE_SZ ) );
+  return wksp;
+}
+
+static void
+test_wksp_delete_mmap( fd_wksp_t * wksp,
+                       ulong       footprint ) {
+  FD_TEST( !fd_shmem_leave_anonymous( wksp, NULL ) );
+  void * mem = fd_wksp_delete( fd_wksp_leave( wksp ) );
+  FD_TEST( mem );
+  FD_TEST( !munmap( mem, footprint ) );
+}
