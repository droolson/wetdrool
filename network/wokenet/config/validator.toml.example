name = "wokenet-validator-01"
telemetry = false

[paths]
    base = "/srv/wokenet/validator-01"
    identity_key = "/run/wokenet-secrets/validator-identity.json"
    vote_account = "/run/wokenet-secrets/vote-account.json"
    authorized_voter_paths = ["/run/wokenet-secrets/authorized-voter.json"]
    genesis = "/srv/wokenet/network/genesis.bin"
    snapshots = "/srv/wokenet/snapshots"
    accounts = "/srv/wokenet/accounts.db"
    shredb = "/srv/wokenet/shreds.db"

[gossip]
    entrypoints = ["entrypoint-01.network.woke.social:8001", "entrypoint-02.network.woke.social:8001"]
    port = 8001

[snapshots]
    genesis_download = false

    [snapshots.sources]
        servers = ["https://snapshot-01.network.woke.social:443"]

        [snapshots.sources.gossip]
            allow_any = false
            allow_list = ["REPLACE_WITH_TRUSTED_SNAPSHOT_VALIDATOR_PUBLIC_KEY"]
            block_list = []

[consensus]
    expected_genesis_hash = "REPLACE_WITH_CEREMONY_GENESIS_HASH"
    # Invalid fail-closed placeholder; replace with the ceremony's non-zero numeric value.
    expected_shred_version = 0
    wokenet_live_cluster = true
    wait_for_vote_to_start_leader = true

[tiles.gui]
    enabled = false

[tiles.rpc]
    enabled = false

[development]
    sandbox = true
    no_clone = false
    no_agave = true

    [development.gossip]
        allow_private_address = false

    [development.genesis]
        validate_genesis_hash = true
        creation_time_unix_seconds = 1785196800
        faucet_balance_lamports = 1
        identity_balance_lamports = 1
        hashes_per_tick = 62500
        target_tick_duration_micros = 6250
        ticks_per_slot = 64
        fund_initial_accounts = 0
        fund_initial_amount_lamports = 0
        vote_account_stake_lamports = 1
        warmup_epochs = false

    [development.bench]
        larger_max_cost_per_block = false
        larger_shred_limits_per_block = false
        disable_blockstore_from_slot = 0
        disable_status_cache = false
