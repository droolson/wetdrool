# Base URL of a compatible WokeSocial indexer. Leave empty to show an
# honest degraded state instead of fabricated feed data.
WOKESOCIAL_INDEXER_URL=
# Canonical server-only WokeNet deployment scope used for address-based
# community directory/detail and public-search requests. Never infer it from
# a route slug or from an indexer's default network.
WOKENET_NETWORK_ID=

# Optional comma-separated provider lists. These are displayed as configured,
# not as healthy, until runtime health checks are implemented.
SOLANA_RPC_ENDPOINTS=
WOKESOCIAL_CONTENT_GATEWAYS=
WOKESOCIAL_RELAY_ENDPOINTS=ws://localhost:4200/v1/relay

# Runtime server origin of the replaceable passkey authentication service.
# Prefer this setting when promoting one immutable web artifact between
# environments. The NEXT_PUBLIC fallback is retained for compatible hosts.
WOKESOCIAL_AUTH_URL=http://localhost:4300

# For local development the auth service must use
# AUTH_ORIGIN=http://localhost:3000 so WebAuthn verification and credentialed
# CORS match this web app exactly.
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4300

# Disabled by default. The browser-writeable CAS exists only for a loopback
# localnet runtime and deliberately fails closed in staging/production.
APP_ENV=development
WOKESOCIAL_LOCAL_CAS_MODE=
WOKESOCIAL_LOCAL_CAS_ORIGIN=http://localhost:3000
WOKESOCIAL_LOCAL_CAS_MAX_BYTES=262144
# When localnet mode is enabled, set this to one absolute directory mounted or
# passed unchanged to the indexer as CONTENT_STORAGE_PATH.
# CONTENT_STORAGE_PATH=/absolute/path/to/wokenet/.local/content

# The first real browser write path is an explicit local-validator proof
# adapter. It remains locked unless this flag is 1 and every RPC, indexer,
# authentication, and CAS endpoint is loopback-only.
WOKESOCIAL_LOCALNET_WRITES=0
NEXT_PUBLIC_SOLANA_CLUSTER=localnet
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_PROGRAM_ID=

# Marketplace (x402 SOL unlock). Default store is in-process memory.
# Optional single-node durability (absolute path) + stable unlock gate secret:
# WETDROOL_MARKETPLACE_DATA_PATH=/absolute/path/to/.local/marketplace/store.json
# WETDROOL_MARKETPLACE_GATE_SECRET=change-me-to-a-long-random-string
# WETDROOL_SOLANA_RPC_URL=http://127.0.0.1:8899
# Non-production only: accept well-formed sigs when RPC missing
# WETDROOL_X402_DEV_ACCEPT=0

# E2EE room ciphertext store (default: process memory). Optional single-node JSON path:
# WETDROOL_ROOMS_DATA_PATH=/absolute/path/to/.local/rooms/store.json


