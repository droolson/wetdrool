{
  "name": "@wetdrool/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replaceable, non-authoritative WetDrool real-time relay",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./protocol": {
      "types": "./dist/src/protocol.d.ts",
      "import": "./dist/src/protocol.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "dev": "node ../../scripts/run-scoped-runtime.mjs --rate-limit -- tsx watch src/main.ts",
    "lint": "eslint src test",
    "start": "node dist/src/main.js",
    "test": "vitest run --exclude 'dist/**' --exclude 'test/**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage --exclude 'dist/**'",
    "test:integration": "vitest run test/**/*.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@wetdrool/config": "workspace:*",
    "@wetdrool/protocol": "workspace:*",
    "@wetdrool/rate-limit": "workspace:*",
    "bs58": "6.0.0",
    "json-canonicalize": "2.0.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
