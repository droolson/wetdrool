{
  "name": "@wetdrool/moderation-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replaceable, non-authoritative WetDrool moderation label, report, and appeal service",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "clean": "rm -rf dist coverage",
    "dev": "node ../../scripts/run-scoped-runtime.mjs --rate-limit MODERATION_DATABASE_URL -- tsx watch src/server.ts",
    "lint": "eslint scripts src test",
    "migrate": "tsx src/migrate.ts",
    "setup:local": "tsx src/migrate.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run --exclude 'dist/**' --exclude 'test/**/*.integration.test.ts'",
    "test:integration": "vitest run --no-file-parallelism test/postgres.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.1.0",
    "@wetdrool/config": "workspace:*",
    "@wetdrool/protocol": "workspace:*",
    "@wetdrool/rate-limit": "workspace:*",
    "fastify": "5.10.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@wetdrool/test-fixtures": "workspace:*",
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
