{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/EnochFAFO",
      "destination": "https://enochfafo.woke.social",
      "permanent": false
    },
    {
      "source": "/EnochFAFO/",
      "destination": "https://enochfafo.woke.social",
      "permanent": false
    },
    {
      "source": "/enochfafo",
      "destination": "https://enochfafo.woke.social",
      "permanent": false
    },
    {
      "source": "/enochfafo/",
      "destination": "https://enochfafo.woke.social",
      "permanent": false
    },
    {
      "source": "/enoch-fafo",
      "destination": "https://enochfafo.woke.social",
      "permanent": false
    },
    {
      "source": "/enoch-fafo/",
      "destination": "https://enochfafo.woke.social",
      "permanent": false
    },
    {
      "source": "/AlexBTC420",
      "destination": "https://alexbtc420.woke.social",
      "permanent": false
    },
    {
      "source": "/AlexBTC420/",
      "destination": "https://alexbtc420.woke.social",
      "permanent": false
    },
    {
      "source": "/alexbtc420",
      "destination": "https://alexbtc420.woke.social",
      "permanent": false
    },
    {
      "source": "/alexbtc420/",
      "destination": "https://alexbtc420.woke.social",
      "permanent": false
    },
    {
      "source": "/hailmary",
      "destination": "/HAILMARY",
      "permanent": false
    },
    {
      "source": "/hailmary/",
      "destination": "/HAILMARY",
      "permanent": false
    },
    {
      "source": "/HailMary",
      "destination": "/HAILMARY",
      "permanent": false
    },
    {
      "source": "/HailMary/",
      "destination": "/HAILMARY",
      "permanent": false
    },
    {
      "source": "/order-hail-mary",
      "destination": "/HAILMARY",
      "permanent": false
    },
    {
      "source": "/order-hail-mary/",
      "destination": "/HAILMARY",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/docs/", "destination": "/docs.html" },
    { "source": "/HAILMARY", "destination": "/HAILMARY.html" },
    { "source": "/HAILMARY/", "destination": "/HAILMARY.html" },
    { "source": "/landing", "destination": "/index.html" },
    { "source": "/Landing.dc.html", "destination": "/index.html" },
    { "source": "/Docs.dc.html", "destination": "/docs.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_ds/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
