# Public runtime configuration. These values are embedded in the Android app;
# never put API secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SOLANA_CHAIN=solana:devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Set all three after the WokeSocial program is deployed to the selected Solana
# cluster. Do not use the deterministic local test program ID on public Solana.
EXPO_PUBLIC_WOKESOCIAL_PROGRAM_ID=
EXPO_PUBLIC_WOKESOCIAL_DEPLOYMENT_ID=
EXPO_PUBLIC_WOKESOCIAL_INDEXER_URL=
