{
  "name": "@wetdrool/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open, rebuildable DroolNet social-protocol indexer",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "check:anchor-events": "tsx scripts/check-anchor-events.ts",
    "clean": "rm -rf dist coverage",
    "dev": "node ../../scripts/run-scoped-runtime.mjs --rate-limit DATABASE_URL -- tsx watch src/dev.ts",
    "lint": "eslint scripts src test",
    "migrate": "tsx src/migrate.ts",
    "rebuild:projection": "node dist/src/rebuild-cli.js",
    "setup:local": "tsx src/setup-local.ts",
    "start": "node dist/src/server.js",
    "test": "vitest run --exclude 'dist/**' --exclude 'test/**/*.integration.test.ts'",
    "test:integration": "vitest run --no-file-parallelism test/postgres.integration.test.ts test/pending-manifest-postgres.integration.test.ts test/handles.integration.test.ts test/governance.integration.test.ts test/recovery.integration.test.ts test/payments.integration.test.ts test/network-scope-migration.integration.test.ts test/profile-confidentiality-migration.integration.test.ts test/identity-deactivation-migration.integration.test.ts test/manifest-ingestion-state-migration.integration.test.ts test/verified-community-migration.integration.test.ts test/identity-deactivation.integration.test.ts",
    "test:solana:integration": "RUN_SOLANA_INDEXER_INTEGRATION=1 vitest run test/solana.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@opentelemetry/api": "1.9.1",
    "@solana/kit": "7.0.0",
    "@wetdrool/config": "workspace:*",
    "@wetdrool/protocol": "workspace:*",
    "@wetdrool/rate-limit": "workspace:*",
    "@wetdrool/storage": "workspace:*",
    "bs58": "6.0.0",
    "fastify": "5.11.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@noble/curves": "2.2.0",
    "@types/node": "22.20.1",
    "@wetdrool/test-fixtures": "workspace:*",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
