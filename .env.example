# Copy to .env for local overrides. Never commit real credentials.
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1

# Public browser configuration. Production uses https://woke.social;
# sociallywoke.com is redirect-only and is never an application/CORS origin.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4300
NEXT_PUBLIC_FEED_SERVICE_URL=http://localhost:4100
# Use localnet, devnet, or mainnet-beta and never embed RPC credentials.
NEXT_PUBLIC_SOLANA_CLUSTER=localnet
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_INDEXER_URL=http://localhost:4000
NEXT_PUBLIC_MEDIA_WORKER_URL=http://localhost:4500
NEXT_PUBLIC_MODERATION_SERVICE_URL=http://localhost:4400
NEXT_PUBLIC_RELAY_URL=ws://localhost:4200/v1/relay
NEXT_PUBLIC_IPFS_GATEWAY_URL=http://127.0.0.1:8080
NEXT_PUBLIC_PROGRAM_ID=9kFGJEzA7uKvJ1wTvKRWoFadRU7WFnpwWEGP6APro3dD

# Provider lists consumed by the current server-rendered web settings and feed.
WOKESOCIAL_INDEXER_URL=http://localhost:4000
WOKESOCIAL_AUTH_URL=http://localhost:4300
SOLANA_RPC_ENDPOINTS=http://127.0.0.1:8899
WOKESOCIAL_CONTENT_GATEWAYS=http://127.0.0.1:8080
WOKESOCIAL_RELAY_ENDPOINTS=ws://localhost:4200/v1/relay

# Server origins and sessions
ALLOWED_ORIGINS=http://localhost:3000
SESSION_SECRET=local-development-session-secret-change-me
# Empty means every service ignores forwarded client-address headers. Set only
# to exact ingress IP/CIDR ranges when application ports are private to it.
TRUSTED_PROXY_CIDRS=

# Local PostgreSQL
POSTGRES_HOST_PORT=5432
POSTGRES_DB=wokesocial
POSTGRES_USER=wokesocial
POSTGRES_PASSWORD=local-development-only
INDEXER_DATABASE_RUNTIME_PASSWORD=local-indexer-runtime-only
INDEXER_DATABASE_MIGRATION_PASSWORD=local-indexer-migration-only
DATABASE_URL=postgresql://wokesocial_indexer_runtime:local-indexer-runtime-only@127.0.0.1:5432/wokesocial
DATABASE_MIGRATION_URL=postgresql://wokesocial_indexer_migration:local-indexer-migration-only@127.0.0.1:5432/wokesocial

# Local Redis
REDIS_HOST_PORT=6379
REDIS_PASSWORD=local-development-only
REDIS_URL=redis://:local-development-only@127.0.0.1:6379
# HMAC key for disposable rate-limit bucket identifiers. Generate one private
# value per deployment environment, inject that identical value into every
# replica, and keep it stable through rolling deploys. This published local
# value is intentionally rejected outside development.
RATE_LIMIT_KEY_SECRET=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI
# Stable across replicas and rolling deploys; distinct across environments.
RATE_LIMIT_DEPLOYMENT_ID=local-development
# Tests may opt into memory state only while binding a service to loopback.
RATE_LIMIT_DANGEROUSLY_USE_MEMORY_STORE=0

# Local Kubo/IPFS
IPFS_API_HOST_PORT=5001
IPFS_GATEWAY_HOST_PORT=8080
IPFS_SWARM_HOST_PORT=4001
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# Solana/indexer
SOLANA_RPC_URLS=http://127.0.0.1:8899
SOLANA_WS_URLS=ws://127.0.0.1:8900
SOLANA_COMMITMENT=finalized
# Compose explicitly overrides the image's fail-closed production defaults.
INDEXER_APP_ENV=development
INDEXER_NODE_ENV=development
# Set only to a verified exact value; absence keeps live ingestion disabled.
# INDEXER_NETWORK_ID=wokenet:v1:<genesis-hash>:<program-id>
INDEXER_HOST=127.0.0.1
INDEXER_PORT=4000
CONTENT_STORAGE_PATH=.local/content
INDEXER_DEPLOYMENT_SLOT=0
# Immutable per network: schema-v1 profiles are historical-only before this slot.
INDEXER_PROFILE_V2_ACTIVATION_SLOT=0
INDEXER_BATCH_SIZE=100
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_RETRY_ATTEMPTS=3
INDEXER_RETRY_BASE_MS=250
INDEXER_RETRY_MAX_MS=60000
INDEXER_SYNC_STALE_AFTER_MS=30000
# Compose uses this container-reachable host alias instead of 127.0.0.1.
INDEXER_SOLANA_RPC_URLS=http://host.docker.internal:8899

# Replaceable feed service
FEED_SERVICE_HOST=127.0.0.1
FEED_SERVICE_PORT=4100
FEED_SERVICE_CORS_ORIGINS=http://localhost:3000

# The standalone relay stays locked. The root `pnpm dev` command enables
# advisory unverified behavior only after enforcing development mode and
# loopback binds. Every shared/production composition needs a real authorizer.
RELAY_HOST=127.0.0.1
RELAY_PORT=4200
RELAY_ID=wokesocial-local
RELAY_ALLOWED_ORIGINS=http://localhost:3000
RELAY_DANGEROUSLY_ALLOW_UNVERIFIED_LOCAL_MODE=0
# Verified deployments may point at any compatible finalized-state authorizer.
# The adapter is fail-closed; production URLs must use HTTPS.
RELAY_KEY_AUTHORIZER_URL=
RELAY_KEY_AUTHORIZER_READINESS_URL=
RELAY_KEY_AUTHORIZER_BEARER_TOKEN=
RELAY_KEY_AUTHORIZER_TIMEOUT_MS=2000
RELAY_SUBSCRIPTION_AUTHORIZER_URL=
RELAY_SUBSCRIPTION_AUTHORIZER_READINESS_URL=
RELAY_SUBSCRIPTION_AUTHORIZER_BEARER_TOKEN=
RELAY_SUBSCRIPTION_AUTHORIZER_TIMEOUT_MS=2000

# Passkey relying-party service. AUTH_ORIGIN is the browser origin whose
# WebAuthn ceremonies and credentialed requests are accepted. Production uses
# RP ID woke.social and exact origin https://woke.social, never the legacy host.
AUTH_HOST=127.0.0.1
AUTH_PORT=4300
AUTH_RP_NAME=WokeSocial
AUTH_RP_ID=localhost
AUTH_ORIGIN=http://localhost:3000
# Keep runtime DML and one-shot DDL roles separate outside local development.
AUTH_DATABASE_RUNTIME_PASSWORD=local-auth-runtime-only
AUTH_DATABASE_MIGRATION_PASSWORD=local-auth-migration-only
AUTH_DATABASE_URL=postgresql://wokesocial_auth_runtime:local-auth-runtime-only@127.0.0.1:5432/wokesocial
AUTH_DATABASE_MIGRATION_URL=postgresql://wokesocial_auth_migration:local-auth-migration-only@127.0.0.1:5432/wokesocial
AUTH_DANGEROUSLY_USE_MEMORY_STORE=0
AUTH_CLEANUP_INTERVAL_MS=60000
AUTH_PENDING_ACCOUNT_RETENTION_MS=3600000
AUTH_CEREMONY_RETENTION_MS=86400000
AUTH_SESSION_RETENTION_MS=604800000
AUTH_CLEANUP_BATCH_SIZE=500

# Local-only encrypted moderation ledger. The key is public and deterministic,
# so it is never valid for shared data. Production requires independently
# injected keys and verified object/operator authorization.
MODERATION_HOST=127.0.0.1
MODERATION_PORT=4400
MODERATION_ALLOWED_ORIGINS=http://localhost:3000
# Keep runtime DML and one-shot DDL roles separate outside local development.
MODERATION_DATABASE_RUNTIME_PASSWORD=local-moderation-runtime-only
MODERATION_DATABASE_MIGRATION_PASSWORD=local-moderation-migration-only
MODERATION_DATABASE_URL=postgresql://wokesocial_moderation_runtime:local-moderation-runtime-only@127.0.0.1:5432/wokesocial
MODERATION_DATABASE_MIGRATION_URL=postgresql://wokesocial_moderation_migration:local-moderation-migration-only@127.0.0.1:5432/wokesocial
MODERATION_DATA_KEYS={"activeKeyId":"local-v1","keys":{"local-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE"}}
MODERATION_DANGEROUSLY_ALLOW_UNVERIFIED_LOCAL_MODE=0

# The packaged media worker requires a private ClamAV daemon and a strong
# operator bearer token. This all-zero token is intentionally public and valid
# only for isolated local development; replace it in every shared environment.
MEDIA_WORKER_HOST=127.0.0.1
MEDIA_WORKER_PORT=4500
MEDIA_WORKER_ALLOWED_ORIGINS=http://localhost:3000
MEDIA_WORKER_CLAMD_HOST=127.0.0.1
MEDIA_WORKER_CLAMD_PORT=3310
MEDIA_WORKER_CLAMD_CONNECT_TIMEOUT_MS=5000
MEDIA_WORKER_CLAMD_SCAN_TIMEOUT_MS=120000
MEDIA_WORKER_CLAMD_STREAM_MAX_BYTES=100000000
MEDIA_WORKER_CLAMD_MAX_DATABASE_AGE_MS=259200000
MEDIA_WORKER_STATIC_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
MEDIA_WORKER_STAGING_ROOT=.local/media-worker/staging
MEDIA_WORKER_TEMPORARY_ROOT=.local/media-worker/temporary
MEDIA_WORKER_STORAGE_ROOT=.local/media-worker/cas
MEDIA_WORKER_CLEANUP_INTERVAL_MS=900000
CLAMAV_FRESHCLAM_CHECKS=24

# Sponsorship is off unless a separately controlled signer and budget are configured.
SPONSOR_ENABLED=false
SPONSOR_SIGNER_URI=
SPONSOR_DAILY_LAMPORT_LIMIT=0

# OpenTelemetry export is optional in local development.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=wokesocial
