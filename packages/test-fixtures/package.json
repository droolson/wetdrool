{
  "name": "@socially-woke/test-fixtures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, public test identities and canonical protocol manifests",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
