{
  "name": "@socially-woke/storage",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Replaceable content-addressed storage adapters for Socially Woke",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src test",
    "test": "vitest run --exclude 'dist/**' --exclude 'test/**/*.integration.test.ts'",
    "test:integration": "vitest run test/ipfs.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@socially-woke/protocol": "workspace:*",
    "multiformats": "14.0.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "vitest": "4.1.10"
  }
}
