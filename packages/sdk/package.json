{
  "name": "@socially-woke/sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Provider-neutral publication and Woke Network protocol client SDK for Socially Woke",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src test",
    "test": "vitest run --exclude 'dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solana/kit": "7.0.0",
    "@socially-woke/protocol": "workspace:*",
    "@socially-woke/storage": "workspace:*"
  },
  "devDependencies": {
    "@noble/curves": "2.2.0",
    "bs58": "6.0.0",
    "vitest": "4.1.10"
  }
}
