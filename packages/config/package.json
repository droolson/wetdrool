{
  "name": "@wetdrool/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./network-security": {
      "types": "./dist/network-security.d.ts",
      "import": "./dist/network-security.js"
    },
    "./runtime-security": {
      "types": "./dist/runtime-security.d.ts",
      "import": "./dist/runtime-security.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "import": "./dist/rate-limit.js"
    },
    "./migration-integrity": {
      "types": "./dist/migration-integrity.d.ts",
      "import": "./dist/migration-integrity.js"
    },
    "./trusted-proxy": {
      "types": "./dist/trusted-proxy.d.ts",
      "import": "./dist/trusted-proxy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "dev": "node ../../scripts/run-scoped-runtime.mjs -- tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "env:check": "node --env-file-if-exists=../../.env --experimental-strip-types src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude 'test/**/*.integration.test.ts'",
    "test:integration": "pnpm build && vitest run test/database-tls.integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude 'test/**/*.integration.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/proxy-addr": "5.1.0",
    "ipaddr.js": "2.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "postgres": "3.4.9",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
