{
  "name": "@wetdrool/middle-out-lite",
  "version": "0.1.0",
  "private": false,
  "description": "Portable middle-out compression subset for WetDrool E2EE envelopes (WokeNet-inspired CDC + content addressing)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
